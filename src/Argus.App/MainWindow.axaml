<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Argus.App.ViewModels"
        xmlns:conv="using:Argus.App.Converters"
        x:Class="Argus.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ARGUS"
        Icon="avares://Argus/Assets/argus.ico"
        Width="1240"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        Background="{StaticResource ArgusBgCanvasBrush}">

  <Grid x:Name="RootShell" RowDefinitions="38,*">

    <!-- Custom Frameless Futuristic Title Bar (preserves Windows Snap & resize borders) -->
    <Border Grid.Row="0"
            x:Name="TitleBarRegion"
            Background="#080C1F"
            BorderBrush="{StaticResource ArgusBorderBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed"
            DoubleTapped="OnTitleBarDoubleTapped">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Left Brand & Active Section Breadcrumb -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center">
          <Image Source="avares://Argus/Assets/argus-icon.png"
                 Width="18"
                 Height="18"
                 VerticalAlignment="Center" />
          <TextBlock Text="{Binding BrandName}"
                     FontSize="12.5"
                     FontWeight="Bold"
                     LetterSpacing="2.5"
                     Foreground="{StaticResource ArgusTextPrimaryBrush}"
                     VerticalAlignment="Center" />
          <Border Width="1" Height="14" Background="{StaticResource ArgusBorderBrightBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ActiveSectionTitle}"
                     FontSize="12"
                     Foreground="{StaticResource ArgusTextSecondaryBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Right Update Notification + Privilege Shield + Native-style Vector Window Controls -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="privilege-pill elevated"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasUpdateAvailable}"
                  Command="{Binding OpenUpdateSettingsCommand}"
                  ToolTip.Tip="Натисніть, щоб відкрити розділ оновлення програми з GitHub">
            <TextBlock Text="{Binding UpdateBadgeText}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </Button>

          <Button Classes="privilege-pill"
                  Classes.elevated="{Binding IsAdministrator}"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  Command="{Binding RequestElevationCommand}"
                  ToolTip.Tip="{Binding PrivilegeTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Path Width="12"
                    Height="12"
                    Stretch="Uniform"
                    Data="{StaticResource IconShield}"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.5"
                    VerticalAlignment="Center" />
              <TextBlock Text="{Binding PrivilegeBadgeText}"
                         FontSize="11"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Classes="titlebar-btn"
                  Click="OnMinimizeClicked"
                  ToolTip.Tip="Згорнути">
            <Border Width="11"
                    Height="1.5"
                    CornerRadius="1"
                    Background="{Binding $parent[Button].Foreground}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" />
          </Button>

          <Button Classes="titlebar-btn"
                  Click="OnMaximizeRestoreClicked"
                  ToolTip.Tip="Розгорнути / Відновити">
            <Grid>
              <Path Width="11"
                    Height="11"
                    Stretch="Uniform"
                    IsVisible="{Binding !IsMaximized}"
                    Data="{StaticResource IconWinMaximize}"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.35" />
              <Path Width="11"
                    Height="11"
                    Stretch="Uniform"
                    IsVisible="{Binding IsMaximized}"
                    Data="{StaticResource IconWinRestore}"
                    Stroke="{Binding $parent[Button].Foreground}"
                    StrokeThickness="1.35" />
            </Grid>
          </Button>

          <Button Classes="titlebar-btn titlebar-close"
                  Click="OnCloseClicked"
                  ToolTip.Tip="Закрити">
            <Path Width="11"
                  Height="11"
                  Stretch="Uniform"
                  Data="{StaticResource IconWinClose}"
                  Stroke="{Binding $parent[Button].Foreground}"
                  StrokeThickness="1.45" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Split Shell -->
    <Grid Grid.Row="1" ColumnDefinitions="258,*">

      <!-- Left Navigation Rail -->
      <Border Grid.Column="0"
              Background="{StaticResource ArgusBgRailBrush}"
              BorderBrush="{StaticResource ArgusBorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="14,16,14,16">

          <!-- Brand Crest -->
          <StackPanel Grid.Row="0" Spacing="12" Margin="4,0,4,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Image Grid.Column="0"
                     Source="avares://Argus/Assets/argus-icon.png"
                     Width="28"
                     Height="28"
                     VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Margin="10,0,0,0"
                         Text="{Binding BrandName}"
                         FontSize="19"
                         FontWeight="Bold"
                         LetterSpacing="3.5"
                         VerticalAlignment="Center"
                         Foreground="{StaticResource ArgusTextPrimaryBrush}" />

              <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center" Padding="7,2">
                <TextBlock Text="{Binding VersionBadge}"
                           FontFamily="{StaticResource ArgusMonoFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource ArgusCyanBrush}" />
              </Border>
            </Grid>

            <Border Height="1" Background="{StaticResource ArgusAccentLineBrush}" />
          </StackPanel>

          <!-- Grouped Primary Section Navigation -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding NavigationGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationGroupViewModel">
                  <StackPanel Margin="0,0,0,10">
                    <TextBlock Classes="nav-group-header" Text="{Binding Title}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                          <Button Classes="nav-item"
                                  Classes.active="{Binding IsSelected}"
                                  Margin="0,0,0,3"
                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSectionCommand}"
                                  CommandParameter="{Binding SectionId}">
                            <Grid ColumnDefinitions="20,10,*,Auto">
                              <Path Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    Stretch="Uniform"
                                    Data="{Binding IconResourceKey, Converter={x:Static conv:IconResourceConverter.Instance}}"
                                    Stroke="{Binding $parent[Button].Foreground}"
                                    StrokeThickness="1.45"
                                    StrokeLineCap="Round"
                                    StrokeJoin="Round"
                                    VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2"
                                         Text="{Binding Title}"
                                         FontSize="13"
                                         FontWeight="Medium"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="3"
                                      Margin="8,0,0,0"
                                      IsVisible="{Binding HasBadge}"
                                      Classes="pill"
                                      Padding="6,1"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="10"
                                           Foreground="{StaticResource ArgusVioletSoftBrush}" />
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Footer Navigation -->
          <StackPanel Grid.Row="2" Spacing="10" Margin="0,12,0,0">
            <Border Height="1" Background="{StaticResource ArgusBorderBrush}" />

            <ItemsControl ItemsSource="{Binding FooterNavigation}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NavigationItemViewModel">
                  <Button Classes="nav-item"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectSectionCommand}"
                          CommandParameter="{Binding SectionId}">
                    <Grid ColumnDefinitions="20,10,*">
                      <Path Grid.Column="0"
                            Width="16"
                            Height="16"
                            Stretch="Uniform"
                            Data="{Binding IconResourceKey, Converter={x:Static conv:IconResourceConverter.Instance}}"
                            Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="1.45"
                            StrokeLineCap="Round"
                            StrokeJoin="Round"
                            VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Title}"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Right Workspace Area -->
      <Border Grid.Column="1" Background="{StaticResource ArgusWorkspaceBackdrop}">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Section Header -->
          <Border Grid.Row="0"
                  Padding="28,20,28,16"
                  BorderBrush="{StaticResource ArgusBorderBrush}"
                  BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
              <TextBlock Classes="page-title" Text="{Binding ActiveSectionTitle}" />
              <TextBlock Classes="page-subtitle" Text="{Binding ActiveSectionSubtitle}" />
            </StackPanel>
          </Border>

          <!-- Active View Host -->
          <ContentControl Grid.Row="1"
                          Margin="28,20,24,14"
                          Content="{Binding ActiveSection}" />

          <!-- Bottom Telemetry Status Strip -->
          <Border Grid.Row="2"
                  Background="#080C1E"
                  BorderBrush="{StaticResource ArgusBorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="28,7">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0"
                         FontSize="11.5"
                         Foreground="{StaticResource ArgusTextMutedBrush}"
                         Text="{Binding EngineCaption}" />
              <TextBlock Grid.Column="2"
                         Classes="metric-mono"
                         FontSize="11.5"
                         Text="{Binding RuntimeCaption}" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
