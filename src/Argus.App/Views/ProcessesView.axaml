<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.ProcessesView"
             x:DataType="vm:ProcessesViewModel">

  <Grid RowDefinitions="Auto,12,*">

    <!-- Top Control Panel -->
    <Border Grid.Row="0" Classes="panel-hero">
      <StackPanel Spacing="10">

        <!-- Contextual On-Demand UAC Banner -->
        <Border Classes="uac-callout" IsVisible="{Binding NeedsElevation}">
          <Grid ColumnDefinitions="Auto,10,*,Auto">
            <Path Grid.Column="0"
                  Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Data="{StaticResource IconShield}"
                  Stroke="{DynamicResource ArgusAmberBrush}"
                  StrokeThickness="1.5"
                  VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       FontSize="12"
                       Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="Перегляд процесів, CPU %, RAM і Disk I/O працює без прав адміністратора. Для завершення привілейованих процесів потрібні права адміністратора (UAC)." />
            <Button Grid.Column="3"
                    Margin="12,0,0,0"
                    Classes="privilege-pill"
                    Content="Підвищити права (UAC)"
                    Command="{Binding RequestElevationCommand}"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Mandatory Kill/Terminate Confirmation Banner -->
        <Border Background="{DynamicResource ArgusBgPillDangerBrush}"
                BorderBrush="{DynamicResource ArgusCoralBrush}"
                BorderThickness="1"
                CornerRadius="9"
                Padding="12,9"
                IsVisible="{Binding IsTerminateConfirmationOpen}">
          <Grid ColumnDefinitions="*,12,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock FontSize="12.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource ArgusCoralBrush}"
                         Text="Підтвердження завершення процесу" />
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                         TextWrapping="Wrap"
                         Text="{Binding TerminatePromptText}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="argus-primary"
                      Background="{DynamicResource ArgusCoralBrush}"
                      Padding="12,6"
                      FontSize="12"
                      Content="Так, завершити"
                      Command="{Binding ConfirmTerminateCommand}" />
              <Button Classes="argus-secondary"
                      Padding="12,6"
                      FontSize="12"
                      Content="Скасувати"
                      Command="{Binding CancelTerminateCommand}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Row 1: Summary + Refresh + Inline Expert Mode Toggle -->
        <Grid ColumnDefinitions="*,12,Auto">
          <TextBlock Grid.Column="0"
                     FontSize="12"
                     Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                     Text="{Binding SummaryText}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="argus-secondary"
                    Padding="12,6"
                    FontSize="12"
                    Content="Оновити"
                    IsEnabled="{Binding !IsLoading}"
                    Command="{Binding RefreshCommand}" />
            <Border Classes="expert-toggle-bar"
                    ToolTip.Tip="У базовому режимі критичні системні процеси Windows приховано. Увімкніть «Експертний режим», щоб бачити їх (із захистом від завершення).">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Експертний режим"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ArgusVioletSoftBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding IsExpertMode}"
                              OnContent=""
                              OffContent=""
                              MinWidth="0"
                              Padding="0"
                              VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Action Feedback -->
        <TextBlock FontSize="12"
                   Foreground="{DynamicResource ArgusCyanBrush}"
                   IsVisible="{Binding HasActionFeedback}"
                   Text="{Binding ActionFeedback}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Live Grouped Process Table -->
    <Border Grid.Row="2" Classes="panel" Padding="14">
      <Grid RowDefinitions="Auto,*">
        <!-- Clickable Column Header Strip -->
        <Grid Grid.Row="0" ColumnDefinitions="28,6,78,10,*,10,74,10,92,10,164,10,152" Margin="10,0,18,8">
          <Button Grid.Column="2"
                  Classes="column-sort-header"
                  Classes.active="{Binding IsSortByPid}"
                  HorizontalAlignment="Left"
                  Content="{Binding SortPidHeader}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="PID" />
          <Button Grid.Column="4"
                  Classes="column-sort-header"
                  Classes.active="{Binding IsSortByName}"
                  HorizontalAlignment="Left"
                  Content="{Binding SortNameHeader}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="NAME" />
          <Button Grid.Column="6"
                  Classes="column-sort-header"
                  Classes.active="{Binding IsSortByCpu}"
                  HorizontalAlignment="Right"
                  Content="{Binding SortCpuHeader}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="CPU" />
          <Button Grid.Column="8"
                  Classes="column-sort-header"
                  Classes.active="{Binding IsSortByRam}"
                  HorizontalAlignment="Right"
                  Content="{Binding SortRamHeader}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="RAM" />
          <Button Grid.Column="10"
                  Classes="column-sort-header"
                  Classes.active="{Binding IsSortByDisk}"
                  HorizontalAlignment="Right"
                  Content="{Binding SortDiskHeader}"
                  Command="{Binding SetSortCommand}"
                  CommandParameter="DISK" />
          <TextBlock Grid.Column="12"
                     FontSize="11"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ArgusTextMutedBrush}"
                     Text="ДІЇ"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="1"
                 Classes="argus-list"
                 ItemsSource="{Binding ProcessGroups}"
                 SelectedItem="{Binding SelectedGroup}"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProcessGroupViewModel">
              <Border Classes="tile" Padding="10,8" Margin="0,0,4,6">
                <StackPanel Spacing="0">

                  <!-- Application Group Summary Row -->
                  <Grid ColumnDefinitions="28,6,78,10,*,10,74,10,92,10,164,10,152"
                        Background="Transparent"
                        Cursor="Hand"
                        PointerPressed="OnGroupHeaderPointerPressed">

                    <Button Grid.Column="0"
                            Classes="column-sort-header"
                            Width="24"
                            Height="24"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="10"
                            Content="{Binding ExpandGlyph}"
                            Command="{Binding ToggleExpandedCommand}"
                            ToolTip.Tip="Розгорнути або згорнути список інстансів програми" />

                    <!-- Single-instance PID pill -->
                    <Border Grid.Column="2"
                            Classes="pill"
                            Padding="6,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsSingleInstance}">
                      <TextBlock Classes="metric-mono"
                                 FontSize="11"
                                 Foreground="{DynamicResource ArgusCyanBrush}"
                                 Text="{Binding PidOrCountText}" />
                    </Border>

                    <!-- Multi-instance count badge -->
                    <Border Grid.Column="2"
                            Classes="pill"
                            Padding="6,2"
                            Background="{DynamicResource ArgusBgSelectedBrush}"
                            BorderBrush="{DynamicResource ArgusVioletBrush}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsMultiInstance}">
                      <TextBlock Classes="metric-mono"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ArgusVioletSoftBrush}"
                                 Text="{Binding PidOrCountText}" />
                    </Border>

                    <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ThreadsText}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ArgusTextMutedBrush}"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center" />
                        <Border Classes="pill"
                                Padding="6,1"
                                Background="{DynamicResource ArgusBgPillWarnBrush}"
                                BorderBrush="{DynamicResource ArgusAmberBrush}"
                                IsVisible="{Binding HasCriticalSystem}"
                                ToolTip.Tip="Містить критичний системний процес Windows — завершення заблоковано."
                                VerticalAlignment="Center">
                          <TextBlock Text="Захищено ОС"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusAmberBrush}" />
                        </Border>
                      </WrapPanel>

                      <TextBlock Classes="metric-mono"
                                 FontSize="10.5"
                                 Foreground="{DynamicResource ArgusTextMutedBrush}"
                                 Text="{Binding ExecutablePath}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding ExecutablePath}" />
                    </StackPanel>

                    <TextBlock Grid.Column="6"
                               Classes="metric-mono"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                               Text="{Binding CpuText}" />

                    <TextBlock Grid.Column="8"
                               Classes="metric-mono"
                               FontSize="12"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ArgusCyanBrush}"
                               Text="{Binding MemoryText}" />

                    <TextBlock Grid.Column="10"
                               Classes="metric-mono"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                               Text="{Binding DiskIoText}" />

                    <StackPanel Grid.Column="12"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                      <Button Classes="argus-secondary"
                              Padding="8,4"
                              FontSize="11"
                              Content="Тека"
                              IsEnabled="{Binding HasExecutablePath}"
                              Command="{Binding OpenFolderCommand}"
                              ToolTip.Tip="Відкрити розташування .exe у Провіднику" />
                      <Button Classes="argus-secondary"
                              Padding="9,4"
                              FontSize="11"
                              Foreground="{DynamicResource ArgusCoralBrush}"
                              Content="Завершити"
                              IsVisible="{Binding IsSingleInstance}"
                              IsEnabled="{Binding CanTerminateSingle}"
                              Command="{Binding RequestTerminateSingleCommand}"
                              ToolTip.Tip="Завершити процес (з обов'язковим підтвердженням)" />
                    </StackPanel>
                  </Grid>

                  <!-- Expandable Child Instances Sublist -->
                  <Border IsVisible="{Binding IsExpanded}"
                          Margin="28,8,0,2"
                          Padding="10,6,0,2"
                          BorderBrush="{DynamicResource ArgusBorderBrush}"
                          BorderThickness="2,0,0,0">
                    <ItemsControl ItemsSource="{Binding Instances}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProcessRowViewModel">
                          <Border Background="{DynamicResource ArgusBgCardBrush}"
                                  BorderBrush="{DynamicResource ArgusBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="6"
                                  Padding="8,5"
                                  Margin="0,0,0,4">
                            <Grid ColumnDefinitions="70,10,*,10,74,10,92,10,164,10,152">
                              <Border Grid.Column="0"
                                      Classes="pill"
                                      Padding="6,1"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                <TextBlock Classes="metric-mono"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource ArgusCyanBrush}"
                                           Text="{Binding PidText}" />
                              </Border>

                              <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                <WrapPanel Orientation="Horizontal">
                                  <TextBlock Text="{Binding Name}"
                                             FontSize="12"
                                             FontWeight="Medium"
                                             Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding ThreadsText}"
                                             FontSize="10"
                                             Foreground="{DynamicResource ArgusTextMutedBrush}"
                                             Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                                  <Border Classes="pill"
                                          Padding="5,1"
                                          Background="{DynamicResource ArgusBgPillWarnBrush}"
                                          BorderBrush="{DynamicResource ArgusAmberBrush}"
                                          IsVisible="{Binding IsCriticalSystem}"
                                          ToolTip.Tip="Критичний системний процес Windows — завершення заблоковано."
                                          VerticalAlignment="Center">
                                    <TextBlock Text="Захищено ОС"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ArgusAmberBrush}" />
                                  </Border>
                                </WrapPanel>

                                <TextBlock Classes="metric-mono"
                                           FontSize="10"
                                           Foreground="{DynamicResource ArgusTextMutedBrush}"
                                           Text="{Binding ExecutablePath}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ExecutablePath}" />
                              </StackPanel>

                              <TextBlock Grid.Column="4"
                                         Classes="metric-mono"
                                         FontSize="11.5"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                         Text="{Binding CpuText}" />

                              <TextBlock Grid.Column="6"
                                         Classes="metric-mono"
                                         FontSize="11.5"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource ArgusCyanBrush}"
                                         Text="{Binding MemoryText}" />

                              <TextBlock Grid.Column="8"
                                         Classes="metric-mono"
                                         FontSize="10.5"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                         Text="{Binding DiskIoText}" />

                              <StackPanel Grid.Column="10"
                                          Orientation="Horizontal"
                                          Spacing="6"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center">
                                <Button Classes="argus-secondary"
                                        Padding="8,3"
                                        FontSize="10.5"
                                        Content="Тека"
                                        IsEnabled="{Binding HasExecutablePath}"
                                        Command="{Binding OpenFolderCommand}"
                                        ToolTip.Tip="Відкрити розташування .exe у Провіднику" />
                                <Button Classes="argus-secondary"
                                        Padding="9,3"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource ArgusCoralBrush}"
                                        Content="Завершити"
                                        IsEnabled="{Binding CanTerminate}"
                                        Command="{Binding RequestTerminateCommand}"
                                        ToolTip.Tip="Завершити процес (з обов'язковим підтвердженням)" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
  </Grid>
</UserControl>
