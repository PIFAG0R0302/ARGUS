<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.CleanupView"
             x:DataType="vm:CleanupViewModel">

  <Grid RowDefinitions="Auto,12,*" Margin="0,0,4,6">

    <!-- Top Two-Step Control, Metrics & 0..100% Progress Hero Panel -->
    <Border Grid.Row="0" Classes="panel-hero" Padding="15,11">
      <StackPanel Spacing="9">
        <!-- Contextual UAC Callout (only when non-elevated and UAC rules or System Restore are active) -->
        <Border Classes="uac-callout" IsVisible="{Binding NeedsElevation}">
          <Grid ColumnDefinitions="Auto,10,*,12,Auto">
            <Path Grid.Column="0"
                  Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Data="{StaticResource IconShield}"
                  Stroke="{DynamicResource ArgusAmberBrush}"
                  StrokeThickness="1.6"
                  VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       FontSize="12"
                       Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                       Text="Вибрані системні правила очищення або створення точки System Restore потребують прав адміністратора. Звичайне очищення профілю працює без UAC."
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="4"
                    Classes="privilege-pill"
                    Content="Підвищити права (UAC)"
                    Command="{Binding RequestElevationCommand}"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Classes="section-heading" Text="Двокрокове очищення (JSON)" TextWrapping="Wrap" />
            <TextBlock FontSize="12"
                       Classes.warn-text="{Binding !StatusIsSuccess}"
                       Text="{Binding StatusBannerText}"
                       TextWrapping="Wrap">
              <TextBlock.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusEmeraldBrush}" />
                </Style>
                <Style Selector="TextBlock.warn-text">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Classes="expert-toggle-bar"
                    ToolTip.Tip="Показує ID правил, точні шляхи, маски файлів, позначки UAC і приклади знайдених файлів.">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Експертний режим"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ArgusVioletSoftBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding IsExpertMode}"
                              OnContent=""
                              OffContent=""
                              VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <Button Classes="argus-secondary"
                    Padding="14,7"
                    IsEnabled="{Binding !IsBusy}"
                    Content="Аналізувати систему"
                    Command="{Binding AnalyzeCommand}" />
            <Button Classes="argus-primary"
                    Padding="16,7"
                    IsEnabled="{Binding CanClean}"
                    Content="Очистити вибране"
                    Command="{Binding CleanSelectedCommand}" />
          </StackPanel>
        </Grid>

        <!-- 0..100% Analysis & Cleanup Progress Bar -->
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       FontSize="11.5"
                       Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                       Text="{Binding OperationStageText}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       Classes="metric-mono"
                       FontSize="11.5"
                       Foreground="{DynamicResource ArgusCyanBrush}"
                       Text="{Binding OperationProgressText}" />
          </Grid>
          <ProgressBar Minimum="0"
                       Maximum="100"
                       Value="{Binding OperationProgressPercent}"
                       Height="6"
                       CornerRadius="3"
                       Background="#161E42"
                       Foreground="{DynamicResource ArgusCyanBrush}" />
        </StackPanel>

        <!-- Summary Strip: Found Total, Selected Total, System Restore Switch -->
        <Border Classes="tile" Padding="12,6">
          <Grid ColumnDefinitions="Auto,16,Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock FontSize="12" Foreground="{DynamicResource ArgusTextSecondaryBrush}" Text="Знайдено:" />
              <TextBlock Classes="metric-mono" FontSize="12.5" Text="{Binding TotalFoundSummaryText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock FontSize="12" Foreground="{DynamicResource ArgusTextSecondaryBrush}" Text="Вибрано:" />
              <TextBlock Classes="metric-mono" FontSize="12.5" Foreground="{DynamicResource ArgusVioletSoftBrush}" Text="{Binding SelectedSummaryText}" />
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="12,0,4,0" VerticalAlignment="Center">
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                         Text="Точка System Restore"
                         VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding CreateRestorePointBeforeCleanup}"
                            OnContent=""
                            OffContent=""
                            VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </Border>

    <!-- Adaptive Main Body: External JSON Rules & Scan Breakdown (fills full width and window height) -->
    <Border Grid.Row="2" Classes="panel" Padding="14,12">
      <Grid RowDefinitions="Auto,10,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
            <TextBlock Classes="section-heading" Text="Правила очищення (JSON)" />
            <TextBlock FontSize="11.5"
                       Foreground="{DynamicResource ArgusTextMutedBrush}"
                       Text="{Binding RulesCatalogSummaryText}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Classes="argus-secondary"
                    Padding="9,4"
                    FontSize="11.5"
                    Content="Стандартні"
                    Command="{Binding SelectDefaultRulesCommand}" />
            <Button Classes="argus-secondary"
                    Padding="9,4"
                    FontSize="11.5"
                    Content="Усі"
                    Command="{Binding SelectAllRulesCommand}" />
            <Button Classes="argus-secondary"
                    Padding="9,4"
                    FontSize="11.5"
                    IsEnabled="{Binding !IsBusy}"
                    Content="Перечитати JSON"
                    Command="{Binding ReloadRulesCommand}" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Rules}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CleanupRuleRowItem">
                <Border Classes="tile" Margin="0,0,4,7" Padding="12,9">
                  <Grid ColumnDefinitions="Auto,10,*,Auto">
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="2" Spacing="3" Margin="0,0,12,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="pill" Padding="7,1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CategoryLabel}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusVioletSoftBrush}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Classes="body-muted"
                                 FontSize="11.5"
                                 Text="{Binding Description}" />

                      <!-- Expert-only Rule Metadata: Rule ID, UAC flag, Exact Scope Paths & Samples -->
                      <StackPanel Spacing="3"
                                  Margin="0,2,0,0"
                                  IsVisible="{Binding $parent[UserControl].((vm:CleanupViewModel)DataContext).IsExpertMode}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Classes="pill" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Classes="metric-mono"
                                       FontSize="10"
                                       Foreground="{DynamicResource ArgusCyanBrush}"
                                       Text="{Binding Id, StringFormat='ID: {0}'}" />
                          </Border>
                          <Border Classes="pill pill-warn"
                                  Padding="6,1"
                                  IsVisible="{Binding RequiresElevation}"
                                  VerticalAlignment="Center">
                            <TextBlock Text="Потребує UAC"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ArgusAmberBrush}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="metric-mono"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ArgusTextMutedBrush}"
                                   Text="{Binding ScopePreview}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource ArgusCyanBrush}"
                                   IsVisible="{Binding HasSamplePaths}"
                                   Text="{Binding SamplePathsText}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3"
                                Spacing="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                      <TextBlock Classes="metric-mono"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Right"
                                 Text="{Binding ScannedSizeText}" />
                      <TextBlock FontSize="11"
                                 Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                 HorizontalAlignment="Right"
                                 Text="{Binding ScannedFilesText}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
