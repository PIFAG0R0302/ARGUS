<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid ColumnDefinitions="*,20,*" Margin="0,0,4,12">

      <!-- Left: Live Settings Editor -->
      <Border Grid.Column="0" Classes="panel-hero" VerticalAlignment="Top">
        <StackPanel Spacing="14">
          <TextBlock Classes="section-heading" Text="Параметри телеметрії та оболонки" />

          <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto,10,Auto,10,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="body-muted" Text="Інтервал опитування датчиків (мс)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="argus-numeric" Minimum="250" Maximum="10000" Increment="250" Value="{Binding TelemetryIntervalMs}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="body-muted" Text="Вікно історії графіків (с)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="argus-numeric" Minimum="30" Maximum="3600" Increment="30" Value="{Binding HistoryWindowSeconds}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Classes="body-muted" Text="Поріг перегріву CPU (°C)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="argus-numeric" Minimum="50" Maximum="115" Increment="1" Value="{Binding CpuTemperatureAlertCelsius}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Classes="body-muted" Text="Поріг перегріву GPU (°C)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="6" Grid.Column="1" Classes="argus-numeric" Minimum="50" Maximum="115" Increment="1" Value="{Binding GpuTemperatureAlertCelsius}" />

            <TextBlock Grid.Row="8" Grid.Column="0" Classes="body-muted" Text="Поріг заповнення RAM (%)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="8" Grid.Column="1" Classes="argus-numeric" Minimum="50" Maximum="99" Increment="1" Value="{Binding RamUsageAlertPercent}" />

            <TextBlock Grid.Row="10" Grid.Column="0" Classes="body-muted" Text="Поріг критично малого місця на диску (%)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="10" Grid.Column="1" Classes="argus-numeric" Minimum="2" Maximum="50" Increment="1" Value="{Binding DiskFreeSpaceAlertPercent}" />
          </Grid>

          <!-- Global UI Scaling (80% - 150%) -->
          <Border Classes="tile">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Масштабування інтерфейсу (80% – 150%)"
                             FontSize="13"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted"
                             Text="Динамічний масштаб: Ctrl + '+' / Ctrl + '-' / Ctrl + 0 або Ctrl + коліщатко миші." />
                </StackPanel>
                <Border Grid.Column="1" Classes="pill" Padding="10,4" VerticalAlignment="Center">
                  <TextBlock Classes="metric-mono"
                             FontSize="12.5"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ArgusCyanBrush}"
                             Text="{Binding UiScaleText}" />
                </Border>
              </Grid>

              <Slider Minimum="80"
                      Maximum="150"
                      TickFrequency="5"
                      IsSnapToTickEnabled="True"
                      Value="{Binding UiScalePercent}" />

              <WrapPanel Orientation="Horizontal">
                <Button Classes="filter-pill"
                        Classes.selected="{Binding IsUiScale80}"
                        Margin="0,0,6,4"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="80%"
                        Command="{Binding SetUiScalePresetCommand}"
                        CommandParameter="80" />
                <Button Classes="filter-pill"
                        Classes.selected="{Binding IsUiScale90}"
                        Margin="0,0,6,4"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="90%"
                        Command="{Binding SetUiScalePresetCommand}"
                        CommandParameter="90" />
                <Button Classes="filter-pill"
                        Classes.selected="{Binding IsUiScale100}"
                        Margin="0,0,6,4"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="100%"
                        Command="{Binding SetUiScalePresetCommand}"
                        CommandParameter="100" />
                <Button Classes="filter-pill"
                        Classes.selected="{Binding IsUiScale110}"
                        Margin="0,0,6,4"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="110%"
                        Command="{Binding SetUiScalePresetCommand}"
                        CommandParameter="110" />
                <Button Classes="filter-pill"
                        Classes.selected="{Binding IsUiScale125}"
                        Margin="0,0,6,4"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="125%"
                        Command="{Binding SetUiScalePresetCommand}"
                        CommandParameter="125" />
                <Button Classes="filter-pill"
                        Classes.selected="{Binding IsUiScale150}"
                        Margin="0,0,0,4"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="150%"
                        Command="{Binding SetUiScalePresetCommand}"
                        CommandParameter="150" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="tile">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Увімкнути системний трей" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Показує іконку в треї та сповіщення ЛИШЕ про перегрів CPU/GPU, критично мале місце на диску й погіршення S.M.A.R.T." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSystemTray}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Згортати в системний трей" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Натискання «Закрити» ховає вікно в трей (працює, коли системний трей увімкнено)." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding MinimizeToTrayOnClose}"
                              IsEnabled="{Binding EnableSystemTray}"
                              OnContent=""
                              OffContent=""
                              VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Сповіщати про погіршення S.M.A.R.T. дисків" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Попереджає про перехід накопичувача в стан «Увага» або «Критичний»." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSmartDegradationAlert}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Експертний режим за замовчуванням" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Синхронізується з перемикачем у вкладках (процеси, служби, порти, Instance ID, деталі S.M.A.R.T.)." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding ExpertModeEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Перевіряти оновлення під час запуску" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Тиха перевірка нових релізів на GitHub; встановлення лише після підтвердження." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckUpdatesOnStartup}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Контрольна точка перед очищенням" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Автоматично створювати System Restore перед системними змінами." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CreateRestorePointBeforeCleanup}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Розширені сенсори PawnIO (опційно)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Підписаний драйвер для температур CPU і плати, сумісний із HVCI та Defender." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnablePawnIoExtendedSensors}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" Margin="0,0,12,0">
                  <TextBlock Text="Автозапуск разом із Windows" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                  <TextBlock Classes="body-muted" Text="Тихий старт у фоновому режимі під час входу в Windows." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" OnContent="" OffContent="" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="argus-primary" Content="Зберегти зміни" Command="{Binding SaveSettingsCommand}" />
            <Button Classes="argus-secondary" Content="Скинути до стандартних" Command="{Binding ResetDefaultsCommand}" />
          </StackPanel>

          <TextBlock FontSize="12.5"
                     Foreground="{DynamicResource ArgusEmeraldBrush}"
                     IsVisible="{Binding HasSaveFeedback}"
                     Text="{Binding SaveFeedback}" />
        </StackPanel>
      </Border>

      <!-- Right: Theme Selector + GitHub Updater & Code Signature + System Restore -->
      <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top">

        <!-- Theme Selector (9 Visual Themes: 3 Light + 6 Dark/Graphite) -->
        <Border Classes="panel-hero">
          <StackPanel Spacing="10">
            <StackPanel Spacing="3">
              <TextBlock Classes="section-heading" Text="Тема оформлення" />
              <TextBlock Classes="body-muted" Text="Миттєве перемикання без перезапуску й автозбереження у settings.json." />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ThemeOptions}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ThemeOptionItem">
                  <Button Classes="profile-card"
                          Classes.selected="{Binding IsSelected}"
                          Margin="0,0,8,8"
                          Padding="10,8"
                          Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectThemeCommand}"
                          CommandParameter="{Binding Id}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding CategoryLabel}"
                                 FontSize="10.5"
                                 Foreground="{DynamicResource ArgusTextMutedBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding CanvasBrush}" BorderBrush="{DynamicResource ArgusBorderBrightBrush}" BorderThickness="1" />
                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding PanelBrush}" BorderBrush="{DynamicResource ArgusBorderBrightBrush}" BorderThickness="1" />
                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding PrimaryBrush}" />
                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding SecondaryBrush}" />
                        <Border Width="14" Height="14" CornerRadius="7" Background="{Binding OkBrush}" />
                      </StackPanel>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- GitHub Releases Auto-Update & Authenticode Verification Card -->
        <Border Classes="panel-hero">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Classes="section-heading" Text="Оновлення з GitHub" TextWrapping="Wrap" />
                <TextBlock Classes="body-muted" Text="Перевірка релізів із верифікацією SHA-256 і цифрового підпису." />
              </StackPanel>

              <Button Grid.Column="1"
                      Classes="argus-primary"
                      Content="Перевірити оновлення"
                      IsEnabled="{Binding CanCheckForUpdates}"
                      Command="{Binding CheckForUpdatesCommand}"
                      VerticalAlignment="Center" />
            </Grid>

            <WrapPanel Orientation="Horizontal">
              <Border Classes="pill" Padding="7,2" Margin="0,0,6,4">
                <TextBlock Classes="metric-mono" FontSize="10.5" Foreground="{DynamicResource ArgusCyanBrush}" Text="{Binding CurrentVersionText}" />
              </Border>
              <Border Classes="pill pill-ready" Padding="7,2" Margin="0,0,6,4">
                <TextBlock FontSize="10.5" Foreground="{DynamicResource ArgusEmeraldBrush}" Text="{Binding SignerSummaryText}" />
              </Border>
            </WrapPanel>

            <Grid ColumnDefinitions="Auto,10,*">
              <TextBlock Grid.Column="0" Classes="body-muted" Text="Репозиторій GitHub:" VerticalAlignment="Center" />
              <TextBox Grid.Column="2"
                       Classes="argus-input"
                       Text="{Binding GitHubUpdateRepository}"
                       PlaceholderText="власник/ARGUS" />
            </Grid>

            <TextBlock FontSize="12"
                       TextWrapping="Wrap"
                       Classes.warn-text="{Binding !UpdateStatusIsSuccess}"
                       Text="{Binding UpdateStatusText}">
              <TextBlock.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusCyanBrush}" />
                </Style>
                <Style Selector="TextBlock.warn-text">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>

            <!-- Update Found Card -->
            <Border Classes="tile" Padding="12,10" IsVisible="{Binding IsUpdateAvailable}">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="3" Margin="0,0,10,0">
                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource ArgusEmeraldBrush}" Text="{Binding AvailableUpdateTitle}" />
                    <TextBlock Classes="body-muted" Text="{Binding AvailableUpdateNotes}" MaxLines="3" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="argus-primary"
                          Content="Завантажити й оновити"
                          IsEnabled="{Binding CanDownloadUpdate}"
                          Command="{Binding RequestInstallUpdateCommand}"
                          VerticalAlignment="Center" />
                </Grid>

                <!-- Inline Confirmation Prompt before Downloading & Launching Installer -->
                <Border Background="#181236"
                        BorderBrush="{DynamicResource ArgusVioletBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        IsVisible="{Binding IsUpdateConfirmationOpen}">
                  <StackPanel Spacing="8">
                    <TextBlock FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                               Text="Оновити встановлений ARGUS до нової версії з GitHub?"
                               TextWrapping="Wrap" />
                    <TextBlock FontSize="11.5"
                               Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                               Text="ARGUS завантажить пакет оновлення, перевірить SHA-256 і цифровий підпис, автоматично замінить файли встановленої програми (без майстра інсталяції) й перезапуститься."
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="argus-primary"
                              Padding="12,6"
                              FontSize="12"
                              Content="Так, оновити зараз"
                              Command="{Binding ConfirmAndInstallUpdateCommand}" />
                      <Button Classes="argus-secondary"
                              Padding="12,6"
                              FontSize="12"
                              Content="Скасувати"
                              Command="{Binding CancelUpdateConfirmationCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- 0..100% Download & Verification Progress -->
                <StackPanel Spacing="4" IsVisible="{Binding IsDownloadingUpdate}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{DynamicResource ArgusTextSecondaryBrush}" Text="{Binding UpdateDownloadStageText}" />
                    <TextBlock Grid.Column="1" Classes="metric-mono" FontSize="11.5" Foreground="{DynamicResource ArgusCyanBrush}" Text="{Binding UpdateDownloadPercentText}" />
                  </Grid>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateDownloadPercent}" Height="6" CornerRadius="3" Foreground="{DynamicResource ArgusCyanBrush}" Background="#141C3D" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" Margin="0,0,12,0">
                <TextBlock Classes="section-heading" Text="Захист системи (System Restore)" />
                <TextBlock Classes="body-muted" Text="Створення контрольної точки відновлення Windows через WMI." />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="argus-secondary"
                      Content="Створити точку"
                      IsEnabled="{Binding !IsCreatingRestorePoint}"
                      Command="{Binding CreateRestorePointNowCommand}"
                      VerticalAlignment="Center" />
            </Grid>

            <!-- Contextual UAC Callout for System Restore -->
            <Border Classes="uac-callout" IsVisible="{Binding NeedsElevation}">
              <Grid ColumnDefinitions="Auto,10,*,12,Auto">
                <Path Grid.Column="0"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Data="{StaticResource IconShield}"
                      Stroke="{DynamicResource ArgusAmberBrush}"
                      StrokeThickness="1.6"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="11.5"
                           Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                           Text="Створення контрольної точки відновлення Windows потребує прав адміністратора (UAC)."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="4"
                        Classes="privilege-pill"
                        Content="Підвищити права (UAC)"
                        Command="{Binding RequestElevationCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <TextBlock FontSize="12.5"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasRestoreFeedback}"
                       Classes.warn-text="{Binding !RestoreFeedbackSuccess}"
                       Text="{Binding RestoreFeedback}">
              <TextBlock.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusEmeraldBrush}" />
                </Style>
                <Style Selector="TextBlock.warn-text">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>

            <Border Classes="tile" Padding="12,9">
              <StackPanel Spacing="4">
                <TextBlock FontSize="11.5" Foreground="{DynamicResource ArgusTextMutedBrush}" Text="{Binding SettingsFilePath, StringFormat='Конфігурація: {0}'}" TextWrapping="Wrap" />
                <TextBlock FontSize="11.5" Foreground="{DynamicResource ArgusTextMutedBrush}" Text="{Binding LogsDirectoryPath, StringFormat='Діагностичні логи: {0}'}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
