<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

  <UserControl.Styles>
    <Style Selector="Button.device-group-header">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.device-group-header:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <!-- Fully Adaptive Layout: Top hardware matrix (Auto) + Grouped Device List stretching to window bottom (*) -->
  <Grid RowDefinitions="Auto,12,*" Margin="0,0,4,6">

    <!-- Top Hardware Inventory Deck (2x2 Matrix: CPU/Cache, Motherboard/BIOS, SMBIOS RAM Slots, GPU/Network) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,12,*" RowDefinitions="Auto,10,Auto">

      <!-- Card 1: CPU & L2/L3 Cache -->
      <Border Grid.Row="0" Grid.Column="0" Classes="panel" Padding="14,10">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-heading" Text="Процесор" IsVisible="{Binding !IsExpertMode}" VerticalAlignment="Center" />
            <TextBlock Classes="section-heading" Text="Процесор і кеш-пам'ять" IsVisible="{Binding IsExpertMode}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="pill" IsVisible="{Binding IsExpertMode}">
              <TextBlock Text="WMI / Топологія" FontSize="10.5" Foreground="{DynamicResource ArgusCyanBrush}" />
            </Border>
          </Grid>
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                     Text="{Binding CpuTitle}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="metric-mono"
                     FontSize="11.5"
                     IsVisible="{Binding IsExpertMode}"
                     Text="{Binding CpuTopologyAndClockText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="11.5"
                     Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                     IsVisible="{Binding IsExpertMode}"
                     Text="{Binding CpuCacheAndArchText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!-- Card 2: Motherboard & UEFI/BIOS -->
      <Border Grid.Row="0" Grid.Column="2" Classes="panel" Padding="14,10">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-heading" Text="Системна плата" IsVisible="{Binding !IsExpertMode}" VerticalAlignment="Center" />
            <TextBlock Classes="section-heading" Text="Системна плата та UEFI / BIOS" IsVisible="{Binding IsExpertMode}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="pill" IsVisible="{Binding IsExpertMode}">
              <TextBlock Text="SMBIOS" FontSize="10.5" Foreground="{DynamicResource ArgusVioletSoftBrush}" />
            </Border>
          </Grid>
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                     Text="{Binding BoardTitle}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="metric-mono"
                     FontSize="11.5"
                     IsVisible="{Binding IsExpertMode}"
                     Text="{Binding BiosSummaryText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="11.5"
                     Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                     IsVisible="{Binding IsExpertMode}"
                     Text="{Binding OsAndFirmwareText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>

      <!-- Card 3: Physical RAM Slots -->
      <Border Grid.Row="2" Grid.Column="0" Classes="panel" Padding="14,10">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-heading"
                       Text="Модулі оперативної пам'яті"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="pill" Margin="10,0,0,0">
              <TextBlock Classes="metric-mono"
                         FontSize="11"
                         Text="{Binding RamSummaryTitle}"
                         VerticalAlignment="Center" />
            </Border>
          </Grid>
          <ScrollViewer MaxHeight="96" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RamSlots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RamSlotRowItem">
                  <Border Classes="tile" Margin="0,0,0,4" Padding="10,5">
                    <Grid ColumnDefinitions="Auto,10,Auto,10,*">
                      <TextBlock Grid.Column="0"
                                 FontSize="11.5"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource ArgusVioletSoftBrush}"
                                 Text="{Binding SlotLocator}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Classes="metric-mono"
                                 FontSize="11.5"
                                 Text="{Binding CapacityAndSpeed}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                 HorizontalAlignment="Right"
                                 Text="{Binding VendorAndPart}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Card 4: GPU & Network Interfaces -->
      <Border Grid.Row="2" Grid.Column="2" Classes="panel" Padding="14,10">
        <StackPanel Spacing="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section-heading" Text="Відеокарта" IsVisible="{Binding !IsExpertMode}" VerticalAlignment="Center" />
            <TextBlock Classes="section-heading" Text="Відеокарта та мережа" IsVisible="{Binding IsExpertMode}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Classes="pill pill-ready" IsVisible="{Binding IsExpertMode}">
              <TextBlock Text="Активні шини" FontSize="10.5" Foreground="{DynamicResource ArgusEmeraldBrush}" />
            </Border>
          </Grid>
          <TextBlock FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                     Text="{Binding PrimaryGpuTitle}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="metric-mono"
                     FontSize="11.5"
                     IsVisible="{Binding IsExpertMode}"
                     Text="{Binding PrimaryGpuDriverAndIdText}"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="11.5"
                     Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                     IsVisible="{Binding IsExpertMode}"
                     Text="{Binding PrimaryNicSummaryText}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Grouped Device Manager Deck (Stretches dynamically to the bottom edge at any resolution) -->
    <Border Grid.Row="2" Classes="panel-hero" Padding="14,12">
      <Grid RowDefinitions="Auto,8,Auto,10,*">

        <!-- Row 0: Section Heading + Expert Actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Classes="section-heading"
                     Text="Підключені пристрої"
                     VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="argus-secondary"
                    Padding="11,6"
                    FontSize="11.5"
                    IsVisible="{Binding IsExpertMode}"
                    Content="Диспетчер пристроїв"
                    ToolTip.Tip="Відкрити системний Диспетчер пристроїв Windows (devmgmt.msc)"
                    Command="{Binding OpenDeviceManagerCommand}" />
            <Button Classes="argus-secondary"
                    Padding="12,6"
                    FontSize="12"
                    IsEnabled="{Binding !IsLoading}"
                    Content="Оновити"
                    Command="{Binding RefreshDevicesCommand}" />
          </StackPanel>
        </Grid>

        <!-- Row 2: Bus & Status Filter Bar -->
        <StackPanel Grid.Row="2" Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsFilterAll}"
                      Padding="10,5"
                      FontSize="11.5"
                      Content="{Binding FilterAllLabel}"
                      Command="{Binding FilterAllCommand}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsFilterPcie}"
                      Padding="10,5"
                      FontSize="11.5"
                      Content="{Binding FilterPcieLabel}"
                      Command="{Binding FilterPcieCommand}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsFilterUsb}"
                      Padding="10,5"
                      FontSize="11.5"
                      Content="{Binding FilterUsbLabel}"
                      Command="{Binding FilterUsbCommand}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsFilterStorage}"
                      Padding="10,5"
                      FontSize="11.5"
                      Content="{Binding FilterStorageLabel}"
                      Command="{Binding FilterStorageCommand}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsFilterNetAudio}"
                      Padding="10,5"
                      FontSize="11.5"
                      Content="{Binding FilterNetAudioLabel}"
                      Command="{Binding FilterNetAudioCommand}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsFilterProblems}"
                      Padding="10,5"
                      FontSize="11.5"
                      Content="{Binding FilterProblemsLabel}"
                      Command="{Binding FilterProblemsCommand}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Classes="metric-mono"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       Text="{Binding ShowingCountText}" />
          </Grid>

          <TextBlock FontSize="11.5"
                     Foreground="{DynamicResource ArgusCyanBrush}"
                     IsVisible="{Binding HasExpertActionFeedback}"
                     Text="{Binding ExpertActionFeedback}"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- Row 4: Adaptive Grouped Expandable Device List (NO fixed MaxHeight) -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding DeviceGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceGroupViewModel">
                <Border Classes="tile" Margin="0,0,4,6" Padding="0">
                  <StackPanel Spacing="0">
                    <!-- Clickable Group Summary Row -->
                    <Button Classes="device-group-header"
                            Command="{Binding ToggleExpandedCommand}">
                      <Grid ColumnDefinitions="20,66,74,*,Auto,200">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding ExpandChevron}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ArgusCyanBrush}"
                                   IsVisible="{Binding HasMultipleItems}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />

                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.pill-ready="{Binding IsAllOk}"
                                Classes.pill-warn="{Binding HasProblem}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="8,2">
                          <TextBlock Text="{Binding StatusLabel}"
                                     FontSize="10.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                        </Border>

                        <Border Grid.Column="2"
                                Classes="pill"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0"
                                Padding="8,2">
                          <TextBlock Text="{Binding BusType}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusCyanBrush}" />
                        </Border>

                        <StackPanel Grid.Column="3" Spacing="2" Margin="10,0,12,0" VerticalAlignment="Center">
                          <TextBlock FontSize="12.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                     Text="{Binding DisplayName}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="11.5"
                                     Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                     Text="{Binding CategoryAndManufacturer}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Border Grid.Column="4"
                                Classes="pill"
                                IsVisible="{Binding HasMultipleItems}"
                                Margin="0,0,12,0"
                                Padding="8,2"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding CountBadgeText}"
                                     FontSize="10.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusVioletSoftBrush}" />
                        </Border>

                        <TextBlock Grid.Column="5"
                                   Classes="metric-mono"
                                   FontSize="11.5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).IsExpertMode}"
                                   Text="{Binding BasicDriverText}"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>

                    <!-- Expandable Child Device Nodes Sublist -->
                    <Border Background="{DynamicResource ArgusBgInputBrush}"
                            BorderBrush="{DynamicResource ArgusBorderBrush}"
                            BorderThickness="0,1,0,0"
                            CornerRadius="0,0,7,7"
                            Padding="14,8"
                            IsVisible="{Binding IsExpanded}">
                      <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DeviceNodeRowItem">
                            <Border Background="{DynamicResource ArgusBgCardBrush}"
                                    BorderBrush="{DynamicResource ArgusBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,0,5"
                                    Padding="10,6">
                              <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,10,0">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Classes="pill"
                                            Classes.pill-ready="{Binding IsOk}"
                                            Classes.pill-warn="{Binding IsProblem}"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                      <TextBlock Text="{Binding StatusLabel}"
                                                 FontSize="10"
                                                 FontWeight="SemiBold"
                                                 Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                                    </Border>
                                    <Border Classes="pill" Padding="6,1" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding BusType}"
                                                 FontSize="10"
                                                 Foreground="{DynamicResource ArgusCyanBrush}" />
                                    </Border>
                                    <TextBlock FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                               Text="{Binding FriendlyName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                  </StackPanel>
                                  <TextBlock FontSize="11"
                                             Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                             Text="{Binding ExpertClassHardwareSummary}"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="metric-mono"
                                             FontSize="11"
                                             Foreground="{DynamicResource ArgusCyanBrush}"
                                             Text="{Binding ExpertDriverAndProblemDetail}"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Classes="metric-mono"
                                             FontSize="10.5"
                                             Foreground="{DynamicResource ArgusTextMutedBrush}"
                                             Text="{Binding InstanceId, StringFormat='Instance ID: {0}'}"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Classes="argus-secondary"
                                        Padding="9,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        Content="Пошук драйверів"
                                        ToolTip.Tip="Запустити пошук і оновлення драйвера для цього пристрою"
                                        Command="{Binding $parent[UserControl].((vm:DevicesViewModel)DataContext).SearchDeviceDriverCommand}"
                                        CommandParameter="{Binding}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
