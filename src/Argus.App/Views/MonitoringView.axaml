<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             xmlns:controls="using:Argus.App.Controls"
             x:Class="Argus.App.Views.MonitoringView"
             x:DataType="vm:MonitoringViewModel">

  <UserControl.Styles>
    <Style Selector="Button.gauge-card">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{StaticResource ArgusBgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ArgusBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.gauge-card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#161D42" />
      <Setter Property="BorderBrush" Value="{StaticResource ArgusVioletBrush}" />
    </Style>
    <Style Selector="Button.gauge-card.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#18204B" />
      <Setter Property="BorderBrush" Value="{StaticResource ArgusCyanBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.section-toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.section-toggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <!-- Compact Top Status & Expert Toggle Bar (Row 0) + Smoothly Scrollable Workspace Below (Row 2) -->
  <Grid RowDefinitions="Auto,8,*" Margin="0,0,4,6">

    <!-- PINNED COMPACT TOP BAR: Sampling Status & Inline Expert Mode Toggle -->
    <StackPanel Grid.Row="0" Spacing="6">
      <!-- Sampling Status Strip & Inline Expert Mode Toggle -->
      <Border Classes="tile" Padding="12,5">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock Grid.Column="0" Classes="metric-mono" Text="{Binding SamplingSummary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="metric-mono" Margin="14,0,0,0" Text="{Binding HistorySummary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     FontSize="11.5"
                     Margin="14,0,12,0"
                     Foreground="{StaticResource ArgusTextMutedBrush}"
                     Text="{Binding LastUpdatedText}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />

          <Border Grid.Column="3"
                  Classes="expert-toggle-bar"
                  ToolTip.Tip="Увімкніть, щоб відкрити експертну діагностику: процеси (PID), служби Windows і локальні порти.">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Експертний режим"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource ArgusVioletSoftBrush}"
                         VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding IsExpertMode}"
                            OnContent=""
                            OffContent=""
                            VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Active Threshold Alert Banner (visible when triggered) -->
      <Border Classes="pill-danger"
              IsVisible="{Binding HasActiveAlert}"
              CornerRadius="8"
              Padding="14,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource ArgusCoralBrush}"
                     Text="{Binding ActiveAlertText}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="argus-secondary"
                  Padding="10,4"
                  FontSize="11.5"
                  Content="Сховати"
                  Command="{Binding DismissAlertCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- SMOOTH SCROLLABLE WORKSPACE: 4 Gauges + Skia Chart + Expert Diagnostics (when enabled) + Lower Hardware Details -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10" Margin="0,0,2,10">

        <!-- Four Interactive Live Skia Radial Gauges (Click to inspect top consumers) -->
        <UniformGrid Columns="4">
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsCpuGaugeSelected}"
                  Margin="0,0,10,0"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="CPU"
                  ToolTip.Tip="Натисніть, щоб переглянути топ-споживачів процесора (CPU)">
            <controls:TelemetryArcGauge Height="130"
                                        IsStandby="{Binding CpuStandby}"
                                        Value="{Binding CpuLoadValue}"
                                        Maximum="100"
                                        DisplayValue="{Binding CpuDisplayValue}"
                                        Unit="%"
                                        Label="Процесор"
                                        SubLabel="{Binding CpuSubLabel}"
                                        AccentStart="#7C5CFF"
                                        AccentEnd="#38D9F5" />
          </Button>
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsRamGaugeSelected}"
                  Margin="0,0,10,0"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="RAM"
                  ToolTip.Tip="Натисніть, щоб переглянути топ-споживачів оперативної пам'яті (RAM)">
            <controls:TelemetryArcGauge Height="130"
                                        IsStandby="{Binding RamStandby}"
                                        Value="{Binding RamLoadValue}"
                                        Maximum="100"
                                        DisplayValue="{Binding RamDisplayValue}"
                                        Unit="ГіБ"
                                        Label="Оперативна пам'ять"
                                        SubLabel="{Binding RamSubLabel}"
                                        AccentStart="#6366F1"
                                        AccentEnd="#38D9F5" />
          </Button>
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsGpuGaugeSelected}"
                  Margin="0,0,10,0"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="GPU"
                  ToolTip.Tip="Натисніть, щоб переглянути топ-споживачів відеокарти (GPU)">
            <controls:TelemetryArcGauge Height="130"
                                        IsStandby="{Binding GpuStandby}"
                                        Value="{Binding GpuLoadValue}"
                                        Maximum="100"
                                        DisplayValue="{Binding GpuDisplayValue}"
                                        Unit="{Binding GpuUnit}"
                                        Label="Відеокарта"
                                        SubLabel="{Binding GpuSubLabel}"
                                        AccentStart="#8B5CF6"
                                        AccentEnd="#2DD4A8" />
          </Button>
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsTempGaugeSelected}"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="TEMP"
                  ToolTip.Tip="Натисніть, щоб переглянути процеси, які найбільше нагрівають систему">
            <controls:TelemetryArcGauge Height="130"
                                        IsStandby="{Binding TempStandby}"
                                        Value="{Binding TempValue}"
                                        Maximum="110"
                                        DisplayValue="{Binding TempDisplayValue}"
                                        Unit="°C"
                                        Label="Температура"
                                        SubLabel="{Binding TempSubLabel}"
                                        AccentStart="#F5A623"
                                        AccentEnd="#F45B69" />
          </Button>
        </UniformGrid>

        <!-- Compact Collapsible Top-Consumers Panel (opens when any circular gauge is clicked) -->
        <Border Classes="panel-hero" Padding="14,10" IsVisible="{Binding IsGaugeConsumersOpen}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="section-heading" Text="{Binding GaugeConsumersTitle}" />
                <TextBlock FontSize="11.5"
                           Foreground="{StaticResource ArgusTextSecondaryBrush}"
                           Text="{Binding GaugeConsumersSubtitle}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="argus-secondary"
                      Padding="10,4"
                      FontSize="11.5"
                      Content="Згорнути"
                      Command="{Binding CloseGaugeConsumersCommand}"
                      VerticalAlignment="Center" />
            </Grid>

            <TextBlock FontSize="12"
                       Foreground="{StaticResource ArgusTextMutedBrush}"
                       Text="{Binding GaugeConsumersEmptyText}"
                       IsVisible="{Binding !HasGaugeConsumers}" />

            <ItemsControl ItemsSource="{Binding GaugeConsumers}" IsVisible="{Binding HasGaugeConsumers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GaugeConsumerItem">
                  <Border Classes="tile" Margin="0,0,0,5" Padding="10,6">
                    <Grid ColumnDefinitions="34,170,76,*,135,140">
                      <Border Grid.Column="0" Classes="pill" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Classes="metric-mono" FontSize="10.5" Text="{Binding RankText}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                 Text="{Binding ProcessName}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="4,0,8,0"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Classes="metric-mono"
                                 FontSize="11"
                                 Foreground="{StaticResource ArgusTextMutedBrush}"
                                 Text="{Binding PidText}"
                                 VerticalAlignment="Center" />
                      <ProgressBar Grid.Column="3"
                                   Minimum="0"
                                   Maximum="100"
                                   Value="{Binding BarPercent}"
                                   Height="6"
                                   Margin="6,0,12,0"
                                   CornerRadius="3"
                                   Background="#1A2248"
                                   Foreground="{StaticResource ArgusCyanBrush}"
                                   VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4"
                                 Classes="metric-mono"
                                 FontSize="11.5"
                                 HorizontalAlignment="Right"
                                 Margin="0,0,10,0"
                                 Text="{Binding PrimaryMetricText}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5"
                                 FontSize="11"
                                 Foreground="{StaticResource ArgusTextSecondaryBrush}"
                                 HorizontalAlignment="Right"
                                 Text="{Binding SecondaryMetricText}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      <!-- Real-Time Skia Multi-Series Chart + Series Filter Toggles + Time Window + Export (Pinned) -->
      <Border Classes="panel-hero" Padding="14,9">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Classes="section-heading"
                       Text="Динаміка в реальному часі (Skia)"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="10,0,12,0" VerticalAlignment="Center">
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow30Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="30 с"
                      Command="{Binding SelectWindow30Command}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow60Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="1 хв"
                      Command="{Binding SelectWindow60Command}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow180Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="3 хв"
                      Command="{Binding SelectWindow180Command}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow300Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="5 хв"
                      Command="{Binding SelectWindow300Command}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Button Classes="argus-secondary"
                      Padding="9,3"
                      FontSize="11"
                      IsEnabled="{Binding !IsExportingReport}"
                      Content="Експорт HTML"
                      Command="{Binding ExportHtmlReportCommand}" />
              <Button Classes="argus-secondary"
                      Padding="8,3"
                      FontSize="11"
                      IsEnabled="{Binding !IsExportingReport}"
                      Content="JSON"
                      Command="{Binding ExportJsonReportCommand}" />
              <Button Classes="argus-secondary"
                      Padding="8,3"
                      FontSize="11"
                      IsEnabled="{Binding !IsExportingReport}"
                      Content="CSV"
                      Command="{Binding ExportCsvReportCommand}" />
            </StackPanel>
          </Grid>

          <!-- Interactive Series Filter Strip (Click to isolate CPU / RAM / GPU / Temp or combine any subset) -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock FontSize="11" Foreground="{StaticResource ArgusTextMutedBrush}" Text="Фільтр графіків:" VerticalAlignment="Center" Margin="0,0,2,0" />

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowCpuSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleCpuSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#38D9F5" VerticalAlignment="Center" />
                  <TextBlock Text="CPU %" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowRamSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleRamSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#9B82FF" VerticalAlignment="Center" />
                  <TextBlock Text="ОЗП %" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowGpuSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleGpuSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#2DD4A8" VerticalAlignment="Center" />
                  <TextBlock Text="GPU %" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowTempSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleTempSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#F5A623" VerticalAlignment="Center" />
                  <TextBlock Text="Темп. °C" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding AreAllSeriesVisible}"
                      Padding="8,3"
                      FontSize="11"
                      Content="Усі"
                      Command="{Binding ShowAllSeriesCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Border Width="12" Height="1.5" Background="#88F45B69" VerticalAlignment="Center" />
              <TextBlock FontSize="11" Foreground="{StaticResource ArgusTextMutedBrush}" Text="Поріг сповіщення" />
            </StackPanel>
          </Grid>

          <controls:TelemetryLineChart Height="106"
                                       PrimarySeries="{Binding CpuSeries}"
                                       SecondarySeries="{Binding RamSeries}"
                                       TertiarySeries="{Binding GpuSeries}"
                                       ThermalSeries="{Binding TempSeries}"
                                       Maximum="100"
                                       WindowSeconds="{Binding SelectedWindowSeconds}"
                                       AlertThreshold="{Binding ActiveAlertThreshold}" />

          <TextBlock FontSize="11.5"
                     IsVisible="{Binding HasExportFeedback}"
                     Classes.warn-text="{Binding !ExportSucceeded}"
                     Text="{Binding ExportFeedback}"
                     TextTrimming="CharacterEllipsis">
            <TextBlock.Styles>
              <Style Selector="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ArgusEmeraldBrush}" />
              </Style>
              <Style Selector="TextBlock.warn-text">
                <Setter Property="Foreground" Value="{StaticResource ArgusAmberBrush}" />
              </Style>
            </TextBlock.Styles>
          </TextBlock>
        </StackPanel>
      </Border>

        <!-- Expert Mode System Inspector Card (Lazy-loaded ONLY when IsExpertMode is ON) -->
        <Border Classes="panel-hero" Padding="15,12" IsVisible="{Binding IsExpertMode}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="section-heading" Text="Експертна діагностика системи" />
                <TextBlock FontSize="11.5"
                           Foreground="{StaticResource ArgusTextSecondaryBrush}"
                           Text="{Binding InspectorSummaryText}" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="argus-secondary"
                        Padding="10,5"
                        FontSize="11.5"
                        Content="Вкладка «Процеси» →"
                        Command="{Binding OpenFullProcessesCommand}"
                        ToolTip.Tip="Відкрити повноцінний диспетчер процесів із CPU %, RAM і Disk I/O" />
                <Button Classes="argus-secondary"
                        Classes.selected="{Binding IsProcessesTab}"
                        Padding="10,5"
                        FontSize="11.5"
                        Content="{Binding ProcessesTabLabel}"
                        Command="{Binding SelectProcessesTabCommand}" />
                <Button Classes="argus-secondary"
                        Classes.selected="{Binding IsServicesTab}"
                        Padding="10,5"
                        FontSize="11.5"
                        Content="{Binding ServicesTabLabel}"
                        Command="{Binding SelectServicesTabCommand}" />
                <Button Classes="argus-secondary"
                        Classes.selected="{Binding IsLocalPortsTab}"
                        Padding="10,5"
                        FontSize="11.5"
                        Content="{Binding LocalPortsTabLabel}"
                        Command="{Binding SelectLocalPortsTabCommand}" />
              </StackPanel>
            </Grid>

            <!-- Search & Refresh Bar -->
            <Grid ColumnDefinitions="*,10,Auto">
              <TextBox Grid.Column="0"
                       Classes="argus-input"
                       Text="{Binding InspectorSearchQuery}"
                       PlaceholderText="Пошук за назвою процесу, PID, службою або портом…" />
              <Button Grid.Column="2"
                      Classes="argus-secondary"
                      Padding="12,7"
                      FontSize="12"
                      IsEnabled="{Binding !IsInspectorLoading}"
                      Content="Оновити"
                      Command="{Binding RefreshInspectorCommand}" />
            </Grid>

            <!-- Contextual UAC Callout for Services or Protected Processes -->
            <Border Classes="uac-callout" IsVisible="{Binding ShowContextualInspectorUac}">
              <Grid ColumnDefinitions="Auto,10,*,12,Auto">
                <Path Grid.Column="0"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Data="{StaticResource IconShield}"
                      Stroke="{StaticResource ArgusAmberBrush}"
                      StrokeThickness="1.6"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="12"
                           Foreground="{StaticResource ArgusTextPrimaryBrush}"
                           Text="{Binding InspectorElevationReason}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="4"
                        Classes="privilege-pill"
                        Content="Підвищити права (UAC)"
                        Command="{Binding RequestElevationCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- Inline Confirmation Strip before Terminating a Process -->
            <Border Classes="pill-danger"
                    CornerRadius="8"
                    Padding="12,8"
                    IsVisible="{Binding HasPendingTerminate}">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ArgusTextPrimaryBrush}"
                           Text="{Binding PendingTerminatePrompt}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="argus-primary"
                        Margin="10,0,6,0"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="Так, завершити"
                        Command="{Binding ConfirmTerminateProcessCommand}" />
                <Button Grid.Column="2"
                        Classes="argus-secondary"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="Скасувати"
                        Command="{Binding CancelTerminateProcessCommand}" />
              </Grid>
            </Border>

            <!-- Inspector Action Feedback -->
            <TextBlock FontSize="11.5"
                       IsVisible="{Binding HasInspectorFeedback}"
                       Classes.warn-text="{Binding !InspectorFeedbackIsSuccess}"
                       Text="{Binding InspectorFeedbackText}"
                       TextWrapping="Wrap">
              <TextBlock.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource ArgusEmeraldBrush}" />
                </Style>
                <Style Selector="TextBlock.warn-text">
                  <Setter Property="Foreground" Value="{StaticResource ArgusAmberBrush}" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>

            <!-- Sub-tab 1: Processes (PID) -->
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsProcessesTab}">
              <ItemsControl ItemsSource="{Binding FilteredProcesses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProcessRowItem">
                    <Border Classes="tile" Margin="0,0,4,5" Padding="10,6">
                      <Grid ColumnDefinitions="64,170,84,64,*,Auto">
                        <Border Grid.Column="0" Classes="pill" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Classes="metric-mono" FontSize="10.5" Text="{Binding PidText}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Classes="metric-mono"
                                   FontSize="11.5"
                                   Text="{Binding MemoryText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   FontSize="11"
                                   Foreground="{StaticResource ArgusTextSecondaryBrush}"
                                   Text="{Binding ThreadsText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4"
                                   FontSize="11"
                                   Foreground="{StaticResource ArgusTextMutedBrush}"
                                   Text="{Binding ExecutablePath}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,10,0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  IsEnabled="{Binding HasExecutablePath}"
                                  Content="Відкрити теку"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).OpenProcessFolderCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  Content="Завершити"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).RequestTerminateProcessCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Sub-tab 2: Windows Services -->
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsServicesTab}">
              <ItemsControl ItemsSource="{Binding FilteredServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WindowsServiceRowItem">
                    <Border Classes="tile" Margin="0,0,4,5" Padding="10,6">
                      <Grid ColumnDefinitions="*,135,96,Auto">
                        <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,10,0" VerticalAlignment="Center">
                          <TextBlock FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                     Text="{Binding DisplayName}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="metric-mono"
                                     FontSize="10.5"
                                     Foreground="{StaticResource ArgusTextMutedBrush}"
                                     Text="{Binding ServiceName}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   FontSize="11"
                                   Foreground="{StaticResource ArgusTextSecondaryBrush}"
                                   Text="{Binding StartType}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Classes="pill"
                                Classes.pill-ready="{Binding IsRunning}"
                                Padding="7,1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                          <TextBlock FontSize="10.5"
                                     Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                     Text="{Binding Status}" />
                        </Border>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  IsEnabled="{Binding IsStopped}"
                                  Content="Запустити"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).StartServiceCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  IsEnabled="{Binding CanStop}"
                                  Content="Зупинити"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).StopServiceCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  IsEnabled="{Binding CanStop}"
                                  Content="Перезапустити"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).RestartServiceCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Sub-tab 3: Local TCP/UDP Ports -->
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsLocalPortsTab}">
              <ItemsControl ItemsSource="{Binding FilteredLocalPorts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalPortRowItem">
                    <Border Classes="tile" Margin="0,0,4,5" Padding="10,6">
                      <Grid ColumnDefinitions="56,220,110,68,*">
                        <Border Grid.Column="0" Classes="pill" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Classes="metric-mono" FontSize="10.5" Text="{Binding Protocol}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Classes="metric-mono"
                                   FontSize="11.5"
                                   Text="{Binding EndpointText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0,8,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   FontSize="11"
                                   Foreground="{StaticResource ArgusTextSecondaryBrush}"
                                   Text="{Binding State}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Classes="metric-mono"
                                   FontSize="11"
                                   Foreground="{StaticResource ArgusVioletSoftBrush}"
                                   Text="{Binding PidText}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                   Text="{Binding ProcessName}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,14,*">

          <!-- Left: Collapsible Live Per-Thread CPU Load Matrix -->
          <Border Grid.Column="0" Classes="panel" VerticalAlignment="Top" Padding="15,12">
            <StackPanel Spacing="9">
              <Button Classes="section-toggle"
                      Command="{Binding ToggleCpuThreadsCommand}"
                      ToolTip.Tip="Натисніть, щоб згорнути або розгорнути завантаження по потоках CPU">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="section-heading" Text="Завантаження по потоках CPU" />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource ArgusTextSecondaryBrush}"
                               Text="{Binding CpuModelName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11.5"
                               Text="{Binding CpuClockAndTopologyText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding CpuThreadsChevron}"
                             FontSize="13"
                             Foreground="{StaticResource ArgusCyanBrush}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>

              <ItemsControl ItemsSource="{Binding CoreLoads}" IsVisible="{Binding IsCpuThreadsExpanded}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CoreLoadItem">
                    <Border Classes="tile" Margin="0,0,8,7" Padding="10,7">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{StaticResource ArgusTextSecondaryBrush}" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1" Classes="metric-mono" FontSize="11.5" Text="{Binding LoadText}" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding LoadPercent}"
                                     Height="5"
                                     CornerRadius="3"
                                     Background="#1A2248"
                                     Foreground="{StaticResource ArgusCyanBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Right: Collapsible GPU Adapter Card -->
          <Border Grid.Column="2" Classes="panel" VerticalAlignment="Top" Padding="15,12">
            <StackPanel Spacing="8">
              <Button Classes="section-toggle"
                      Command="{Binding ToggleGpuDetailsCommand}"
                      ToolTip.Tip="Натисніть, щоб згорнути або розгорнути деталі відеоадаптера">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="section-heading" Text="Відеоадаптер" />
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ArgusTextPrimaryBrush}"
                               Text="{Binding GpuNameText}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="pill pill-ready" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Живий потік" FontSize="10.5" Foreground="{StaticResource ArgusEmeraldBrush}" />
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding GpuDetailsChevron}"
                             FontSize="13"
                             Foreground="{StaticResource ArgusCyanBrush}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>

              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsGpuDetailsExpanded}">
                <TextBlock Grid.Column="0" Classes="metric-mono" Text="{Binding GpuVramDetailText}" />
                <TextBlock Grid.Column="1" Classes="metric-mono" Text="{Binding GpuClockAndFanText}" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
