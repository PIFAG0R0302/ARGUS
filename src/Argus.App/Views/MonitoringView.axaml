<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             xmlns:controls="using:Argus.App.Controls"
             x:Class="Argus.App.Views.MonitoringView"
             x:DataType="vm:MonitoringViewModel">

  <UserControl.Styles>
    <Style Selector="Button.gauge-card">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource ArgusBgPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.gauge-card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ArgusVioletBrush}" />
    </Style>
    <Style Selector="Button.gauge-card.selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ArgusBgSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ArgusCyanBrush}" />
      <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style Selector="Button.section-toggle">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.section-toggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <!-- Compact Top Status Strip (Row 0) + Smoothly Scrollable Workspace Below (Row 2) -->
  <Grid RowDefinitions="Auto,8,*" Margin="0,0,4,6">

    <!-- PINNED COMPACT TOP BAR: Sampling Status -->
    <StackPanel Grid.Row="0" Spacing="6">
      <!-- Sampling Status Strip -->
      <Border Classes="tile" Padding="12,5">
        <Grid ColumnDefinitions="Auto,Auto,*">
          <TextBlock Grid.Column="0" Classes="metric-mono" Text="{Binding SamplingSummary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="metric-mono" Margin="14,0,0,0" Text="{Binding HistorySummary}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     FontSize="11.5"
                     Margin="14,0,0,0"
                     Foreground="{DynamicResource ArgusTextMutedBrush}"
                     Text="{Binding LastUpdatedText}"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Active Threshold Alert Banner (visible when triggered) -->
      <Border Classes="pill-danger"
              IsVisible="{Binding HasActiveAlert}"
              CornerRadius="8"
              Padding="14,7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource ArgusCoralBrush}"
                     Text="{Binding ActiveAlertText}"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Classes="argus-secondary"
                  Padding="10,4"
                  FontSize="11.5"
                  Content="Сховати"
                  Command="{Binding DismissAlertCommand}" />
        </Grid>
      </Border>
    </StackPanel>

    <!-- SMOOTH SCROLLABLE WORKSPACE: 4 Gauges + Top-Consumers Panel + Skia Chart + Lower Hardware Details -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10" Margin="0,0,2,10">

        <!-- Four Interactive Live Skia Radial Gauges (Click to inspect top consumers) -->
        <UniformGrid Columns="4">
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsCpuGaugeSelected}"
                  Margin="0,0,10,0"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="CPU"
                  ToolTip.Tip="Натисніть, щоб переглянути топ-споживачів процесора (CPU)">
            <controls:TelemetryArcGauge Height="130"
                                        IsHitTestVisible="False"
                                        IsStandby="{Binding CpuStandby}"
                                        Value="{Binding CpuLoadValue}"
                                        Maximum="100"
                                        DisplayValue="{Binding CpuDisplayValue}"
                                        Unit="%"
                                        Label="Процесор"
                                        SubLabel="{Binding CpuSubLabel}"
                                        AccentStart="#7C5CFF"
                                        AccentEnd="#38D9F5" />
          </Button>
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsRamGaugeSelected}"
                  Margin="0,0,10,0"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="RAM"
                  ToolTip.Tip="Натисніть, щоб переглянути топ-споживачів оперативної пам'яті (RAM)">
            <controls:TelemetryArcGauge Height="130"
                                        IsHitTestVisible="False"
                                        IsStandby="{Binding RamStandby}"
                                        Value="{Binding RamLoadValue}"
                                        Maximum="100"
                                        DisplayValue="{Binding RamDisplayValue}"
                                        Unit="ГіБ"
                                        Label="Оперативна пам'ять"
                                        SubLabel="{Binding RamSubLabel}"
                                        AccentStart="#6366F1"
                                        AccentEnd="#38D9F5" />
          </Button>
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsGpuGaugeSelected}"
                  Margin="0,0,10,0"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="GPU"
                  ToolTip.Tip="Натисніть, щоб переглянути топ-споживачів відеокарти (GPU)">
            <controls:TelemetryArcGauge Height="130"
                                        IsHitTestVisible="False"
                                        IsStandby="{Binding GpuStandby}"
                                        Value="{Binding GpuLoadValue}"
                                        Maximum="100"
                                        DisplayValue="{Binding GpuDisplayValue}"
                                        Unit="{Binding GpuUnit}"
                                        Label="Відеокарта"
                                        SubLabel="{Binding GpuSubLabel}"
                                        AccentStart="#8B5CF6"
                                        AccentEnd="#2DD4A8" />
          </Button>
          <Button Classes="gauge-card"
                  Classes.selected="{Binding IsTempGaugeSelected}"
                  Command="{Binding SelectGaugeConsumerKindCommand}"
                  CommandParameter="TEMP"
                  ToolTip.Tip="Натисніть, щоб переглянути процеси, які найбільше нагрівають систему">
            <controls:TelemetryArcGauge Height="130"
                                        IsHitTestVisible="False"
                                        IsStandby="{Binding TempStandby}"
                                        Value="{Binding TempValue}"
                                        Maximum="110"
                                        DisplayValue="{Binding TempDisplayValue}"
                                        Unit="°C"
                                        Label="Температура"
                                        SubLabel="{Binding TempSubLabel}"
                                        AccentStart="#F5A623"
                                        AccentEnd="#F45B69" />
          </Button>
        </UniformGrid>

        <!-- Compact Collapsible Top-Consumers Panel (opens when any circular gauge is clicked) -->
        <Border Classes="panel-hero" Padding="14,10" IsVisible="{Binding IsGaugeConsumersOpen}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="section-heading" Text="{Binding GaugeConsumersTitle}" />
                <TextBlock FontSize="11.5"
                           Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                           Text="{Binding GaugeConsumersSubtitle}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Classes="argus-secondary"
                      Padding="10,4"
                      FontSize="11.5"
                      Content="Згорнути"
                      Command="{Binding CloseGaugeConsumersCommand}"
                      VerticalAlignment="Center" />
            </Grid>

            <!-- Contextual UAC Callout for Protected Processes (Expert Mode) -->
            <Border Classes="uac-callout" IsVisible="{Binding ShowGaugeConsumerUacCallout}">
              <Grid ColumnDefinitions="Auto,10,*,12,Auto">
                <Path Grid.Column="0"
                      Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Data="{StaticResource IconShield}"
                      Stroke="{DynamicResource ArgusAmberBrush}"
                      StrokeThickness="1.6"
                      VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           FontSize="12"
                           Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                           Text="{Binding GaugeConsumerElevationReason}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="4"
                        Classes="privilege-pill"
                        Content="Підвищити права (UAC)"
                        Command="{Binding RequestElevationCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>

            <!-- Inline Confirmation Strip before Terminating a Top-Consumer Process or Group -->
            <Border Classes="pill-danger"
                    CornerRadius="8"
                    Padding="12,8"
                    IsVisible="{Binding HasPendingGaugeConsumerTerminate}">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                           Text="{Binding PendingGaugeConsumerTerminatePrompt}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="argus-primary"
                        Margin="10,0,6,0"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="Так, завершити"
                        Command="{Binding ConfirmTerminateGaugeConsumerCommand}" />
                <Button Grid.Column="2"
                        Classes="argus-secondary"
                        Padding="10,4"
                        FontSize="11.5"
                        Content="Скасувати"
                        Command="{Binding CancelTerminateGaugeConsumerCommand}" />
              </Grid>
            </Border>

            <!-- Top-Consumers Action Feedback -->
            <TextBlock FontSize="11.5"
                       IsVisible="{Binding HasGaugeConsumerFeedback}"
                       Classes.warn-text="{Binding !GaugeConsumerFeedbackIsSuccess}"
                       Text="{Binding GaugeConsumerFeedbackText}"
                       TextWrapping="Wrap">
              <TextBlock.Styles>
                <Style Selector="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusEmeraldBrush}" />
                </Style>
                <Style Selector="TextBlock.warn-text">
                  <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
                </Style>
              </TextBlock.Styles>
            </TextBlock>

            <TextBlock FontSize="12"
                       Foreground="{DynamicResource ArgusTextMutedBrush}"
                       Text="{Binding GaugeConsumersEmptyText}"
                       IsVisible="{Binding !HasGaugeConsumers}" />

            <ItemsControl ItemsSource="{Binding GaugeConsumerGroups}" IsVisible="{Binding HasGaugeConsumers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GaugeConsumerGroupViewModel">
                  <Border Classes="tile" Margin="0,0,0,5" Padding="10,6">
                    <StackPanel Spacing="0">
                      <!-- Group Header Row (Click header or chevron to expand/collapse instances) -->
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0"
                                Classes="section-toggle"
                                Command="{Binding ToggleExpandedCommand}"
                                ToolTip.Tip="Натисніть, щоб розгорнути або згорнути екземпляри програми">
                          <Grid ColumnDefinitions="20,34,175,78,*,115,130">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ExpandGlyph}"
                                       FontSize="11"
                                       Foreground="{DynamicResource ArgusCyanBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="pill" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                              <TextBlock Classes="metric-mono" FontSize="10.5" Text="{Binding RankText}" />
                            </Border>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="4,0,8,0"
                                        VerticalAlignment="Center">
                              <TextBlock FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                         Text="{Binding ProcessName}"
                                         TextTrimming="CharacterEllipsis"
                                         VerticalAlignment="Center" />
                              <Border Classes="pill"
                                      Padding="5,1"
                                      Background="{DynamicResource ArgusBgSelectedBrush}"
                                      BorderBrush="{DynamicResource ArgusVioletBrush}"
                                      IsVisible="{Binding IsMultiInstance}"
                                      VerticalAlignment="Center">
                                <TextBlock Classes="metric-mono"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ArgusVioletSoftBrush}"
                                           Text="{Binding CountBadgeText}" />
                              </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="3"
                                       Classes="metric-mono"
                                       FontSize="11"
                                       Foreground="{DynamicResource ArgusTextMutedBrush}"
                                       Text="{Binding PidOrCountText}"
                                       VerticalAlignment="Center" />
                            <ProgressBar Grid.Column="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BarPercent}"
                                         Height="6"
                                         Margin="6,0,12,0"
                                         CornerRadius="3"
                                         Background="{DynamicResource ArgusBorderBrush}"
                                         Foreground="{DynamicResource ArgusCyanBrush}"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       Classes="metric-mono"
                                       FontSize="11.5"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,10,0"
                                       Text="{Binding PrimaryMetricText}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6"
                                       FontSize="11"
                                       Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       Text="{Binding SecondaryMetricText}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </Button>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="5"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).IsExpertMode}">
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  IsEnabled="{Binding HasExecutablePath}"
                                  Content="Відкрити папку"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).OpenGaugeConsumerGroupFolderCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="argus-secondary"
                                  Padding="8,3"
                                  FontSize="11"
                                  IsEnabled="{Binding CanTerminate}"
                                  Content="Завершити"
                                  Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).RequestTerminateGaugeConsumerGroupCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>

                      <!-- Expandable Child Instances -->
                      <Border IsVisible="{Binding IsExpanded}"
                              Margin="20,6,0,2"
                              Padding="10,4,0,0"
                              BorderBrush="{DynamicResource ArgusBorderBrush}"
                              BorderThickness="2,0,0,0">
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GaugeConsumerItem">
                              <Border Background="{DynamicResource ArgusBgCardBrush}"
                                      BorderBrush="{DynamicResource ArgusBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="8,4"
                                      Margin="0,0,0,4">
                                <Grid ColumnDefinitions="32,145,74,*,115,130,Auto">
                                  <Border Grid.Column="0" Classes="pill" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Classes="metric-mono" FontSize="10" Text="{Binding RankText}" />
                                  </Border>
                                  <TextBlock Grid.Column="1"
                                             FontSize="11.5"
                                             FontWeight="Medium"
                                             Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                             Text="{Binding ProcessName}"
                                             TextTrimming="CharacterEllipsis"
                                             Margin="4,0,8,0"
                                             VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="2"
                                             Classes="metric-mono"
                                             FontSize="10.5"
                                             Foreground="{DynamicResource ArgusTextMutedBrush}"
                                             Text="{Binding PidText}"
                                             VerticalAlignment="Center" />
                                  <ProgressBar Grid.Column="3"
                                               Minimum="0"
                                               Maximum="100"
                                               Value="{Binding BarPercent}"
                                               Height="5"
                                               Margin="6,0,10,0"
                                               CornerRadius="3"
                                               Background="{DynamicResource ArgusBorderBrush}"
                                               Foreground="{DynamicResource ArgusCyanBrush}"
                                               VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="4"
                                             Classes="metric-mono"
                                             FontSize="11"
                                             HorizontalAlignment="Right"
                                             Margin="0,0,10,0"
                                             Text="{Binding PrimaryMetricText}"
                                             VerticalAlignment="Center" />
                                  <TextBlock Grid.Column="5"
                                             FontSize="10.5"
                                             Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                             HorizontalAlignment="Right"
                                             Text="{Binding SecondaryMetricText}"
                                             TextTrimming="CharacterEllipsis"
                                             VerticalAlignment="Center" />
                                  <StackPanel Grid.Column="6"
                                              Orientation="Horizontal"
                                              Spacing="5"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).IsExpertMode}">
                                    <Button Classes="argus-secondary"
                                            Padding="7,2"
                                            FontSize="10.5"
                                            IsEnabled="{Binding HasExecutablePath}"
                                            Content="Відкрити папку"
                                            Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).OpenGaugeConsumerFolderCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Classes="argus-secondary"
                                            Padding="7,2"
                                            FontSize="10.5"
                                            IsEnabled="{Binding CanTerminate}"
                                            Content="Завершити"
                                            Command="{Binding $parent[UserControl].((vm:MonitoringViewModel)DataContext).RequestTerminateGaugeConsumerCommand}"
                                            CommandParameter="{Binding}" />
                                  </StackPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

      <!-- Real-Time Skia Multi-Series Chart + Series Filter Toggles + Time Window + Export (Pinned) -->
      <Border Classes="panel-hero" Padding="12,7">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0"
                       Classes="section-heading"
                       Text="Динаміка в реальному часі (Skia)"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="10,0,12,0" VerticalAlignment="Center">
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow30Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="30 с"
                      Command="{Binding SelectWindow30Command}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow60Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="1 хв"
                      Command="{Binding SelectWindow60Command}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow180Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="3 хв"
                      Command="{Binding SelectWindow180Command}" />
              <Button Classes="argus-secondary"
                      Classes.selected="{Binding IsWindow300Selected}"
                      Padding="9,3"
                      FontSize="11"
                      Content="5 хв"
                      Command="{Binding SelectWindow300Command}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Button Classes="argus-secondary"
                      Padding="9,3"
                      FontSize="11"
                      IsEnabled="{Binding !IsExportingReport}"
                      Content="Експорт HTML"
                      Command="{Binding ExportHtmlReportCommand}" />
              <Button Classes="argus-secondary"
                      Padding="8,3"
                      FontSize="11"
                      IsEnabled="{Binding !IsExportingReport}"
                      Content="JSON"
                      Command="{Binding ExportJsonReportCommand}" />
              <Button Classes="argus-secondary"
                      Padding="8,3"
                      FontSize="11"
                      IsEnabled="{Binding !IsExportingReport}"
                      Content="CSV"
                      Command="{Binding ExportCsvReportCommand}" />
            </StackPanel>
          </Grid>

          <!-- Interactive Series Filter Strip (Click to isolate CPU / RAM / GPU / Temp or combine any subset) -->
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock FontSize="11" Foreground="{DynamicResource ArgusTextMutedBrush}" Text="Фільтр графіків:" VerticalAlignment="Center" Margin="0,0,2,0" />

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowCpuSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleCpuSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#38D9F5" VerticalAlignment="Center" />
                  <TextBlock Text="CPU %" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowRamSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleRamSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#9a82FF" VerticalAlignment="Center" />
                  <TextBlock Text="ОЗП %" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowGpuSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleGpuSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#16A34A" VerticalAlignment="Center" />
                  <TextBlock Text="GPU %" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding ShowTempSeries}"
                      Padding="8,3"
                      FontSize="11"
                      Command="{Binding ToggleTempSeriesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                  <Ellipse Width="7" Height="7" Fill="#F5A623" VerticalAlignment="Center" />
                  <TextBlock Text="Темп. °C" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <Button Classes="argus-secondary"
                      Classes.selected="{Binding AreAllSeriesVisible}"
                      Padding="8,3"
                      FontSize="11"
                      Content="Усі"
                      Command="{Binding ShowAllSeriesCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Border Width="12" Height="1.5" Background="#88F45a69" VerticalAlignment="Center" />
              <TextBlock FontSize="11" Foreground="{DynamicResource ArgusTextMutedBrush}" Text="Поріг сповіщення" />
            </StackPanel>
          </Grid>

          <controls:TelemetryLineChart Height="165"
                                       Margin="0,2,0,0"
                                       PrimarySeries="{Binding CpuSeries}"
                                       SecondarySeries="{Binding RamSeries}"
                                       TertiarySeries="{Binding GpuSeries}"
                                       ThermalSeries="{Binding TempSeries}"
                                       Maximum="100"
                                       WindowSeconds="{Binding SelectedWindowSeconds}"
                                       AlertThreshold="{Binding ActiveAlertThreshold}" />

          <TextBlock FontSize="11.5"
                     IsVisible="{Binding HasExportFeedback}"
                     Classes.warn-text="{Binding !ExportSucceeded}"
                     Text="{Binding ExportFeedback}"
                     TextTrimming="CharacterEllipsis">
            <TextBlock.Styles>
              <Style Selector="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ArgusEmeraldBrush}" />
              </Style>
              <Style Selector="TextBlock.warn-text">
                <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
              </Style>
            </TextBlock.Styles>
          </TextBlock>
        </StackPanel>
      </Border>

        <Grid ColumnDefinitions="*,14,*">

          <!-- Left: Collapsible Live Per-Thread CPU Load Matrix (Expert Mode Only) -->
          <Border Grid.Column="0" Classes="panel" VerticalAlignment="Top" Padding="15,12">
            <StackPanel Spacing="9">
              <Button Classes="section-toggle"
                      IsHitTestVisible="{Binding IsExpertMode}"
                      Focusable="{Binding IsExpertMode}"
                      Command="{Binding ToggleCpuThreadsCommand}"
                      ToolTip.Tip="Натисніть, щоб згорнути або розгорнути завантаження по потоках CPU">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="section-heading" Text="Завантаження по потоках CPU" />
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                               Text="{Binding CpuModelName}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11.5"
                               IsVisible="{Binding IsExpertMode}"
                               Text="{Binding CpuClockAndTopologyText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding CpuThreadsChevron}"
                             FontSize="13"
                             Foreground="{DynamicResource ArgusCyanBrush}"
                             IsVisible="{Binding IsExpertMode}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>

              <ItemsControl ItemsSource="{Binding CoreLoads}" IsVisible="{Binding ShowCpuThreadsPanel}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CoreLoadItem">
                    <Border Classes="tile" Margin="0,0,8,7" Padding="10,7">
                      <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" FontSize="11.5" Foreground="{DynamicResource ArgusTextSecondaryBrush}" Text="{Binding Label}" />
                          <TextBlock Grid.Column="1" Classes="metric-mono" FontSize="11.5" Text="{Binding LoadText}" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding LoadPercent}"
                                     Height="5"
                                     CornerRadius="3"
                                     Background="{DynamicResource ArgusBorderBrush}"
                                     Foreground="{DynamicResource ArgusCyanBrush}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Right: Collapsible GPU Adapter Card (Basic: Name only; Expert: VRAM, clocks, expand/collapse) -->
          <Border Grid.Column="2" Classes="panel" VerticalAlignment="Top" Padding="15,12">
            <StackPanel Spacing="8">
              <Button Classes="section-toggle"
                      IsHitTestVisible="{Binding IsExpertMode}"
                      Focusable="{Binding IsExpertMode}"
                      Command="{Binding ToggleGpuDetailsCommand}"
                      ToolTip.Tip="Натисніть, щоб згорнути або розгорнути деталі відеоадаптера">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="section-heading" Text="Відеоадаптер" />
                    <TextBlock FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                               Text="{Binding GpuNameText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11.5"
                               IsVisible="{Binding IsExpertMode}"
                               Text="{Binding GpuVramDetailText}" />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="pill pill-ready" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Живий потік" FontSize="10.5" Foreground="{DynamicResource ArgusEmeraldBrush}" />
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding GpuDetailsChevron}"
                             FontSize="13"
                             Foreground="{DynamicResource ArgusCyanBrush}"
                             IsVisible="{Binding IsExpertMode}"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center" />
                </Grid>
              </Button>

              <Border Classes="tile" Padding="10,7" IsVisible="{Binding ShowGpuDetailsPanel}">
                <TextBlock Classes="metric-mono" FontSize="11.5" Text="{Binding GpuClockAndFanText}" />
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
