<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.DisksView"
             x:DataType="vm:DisksViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="0,0,4,12">

      <!-- Top Safe Policy, Status & 0..100% Optimization Progress Header -->
      <Border Classes="panel-hero" Padding="14,10">
        <StackPanel Spacing="8">
          <!-- Contextual UAC Callout for Disk TRIM / Defragmentation -->
          <Border Classes="uac-callout" IsVisible="{Binding NeedsElevation}">
            <Grid ColumnDefinitions="Auto,10,*,12,Auto">
              <Path Grid.Column="0"
                    Width="16"
                    Height="16"
                    Stretch="Uniform"
                    Data="{StaticResource IconShield}"
                    Stroke="{StaticResource ArgusAmberBrush}"
                    StrokeThickness="1.6"
                    VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         FontSize="12"
                         Foreground="{StaticResource ArgusTextPrimaryBrush}"
                         Text="Діагностика S.M.A.R.T. і карта місця працюють без прав адміністратора. Для запуску оптимізації SSD (TRIM) або дефрагментації HDD потрібне підвищення прав (UAC)."
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="4"
                      Classes="privilege-pill"
                      Content="Підвищити права (UAC)"
                      Command="{Binding RequestElevationCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Classes="section-heading" Text="Політика безпеки та S.M.A.R.T." VerticalAlignment="Center" Margin="0,0,8,4" />
                <Border Classes="pill pill-ready" Padding="7,2" Margin="0,0,6,4">
                  <TextBlock Text="SSD / NVMe: безпечна оптимізація" FontSize="10.5" Foreground="{StaticResource ArgusEmeraldBrush}" />
                </Border>
                <Border Classes="pill" Padding="7,2" Margin="0,0,6,4">
                  <TextBlock Text="HDD: дефрагментація" FontSize="10.5" Foreground="{StaticResource ArgusCyanBrush}" />
                </Border>
                <Border Classes="pill" Padding="7,2" Margin="0,0,6,4">
                  <TextBlock Text="{Binding FleetSummaryText}" FontSize="10.5" Foreground="{StaticResource ArgusVioletSoftBrush}" />
                </Border>
              </WrapPanel>

              <TextBlock FontSize="12"
                         Classes.warn-text="{Binding !StatusIsSuccess}"
                         Text="{Binding StatusBannerText}"
                         TextWrapping="Wrap">
                <TextBlock.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource ArgusEmeraldBrush}" />
                  </Style>
                  <Style Selector="TextBlock.warn-text">
                    <Setter Property="Foreground" Value="{StaticResource ArgusAmberBrush}" />
                  </Style>
                </TextBlock.Styles>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Classes="expert-toggle-bar"
                      ToolTip.Tip="Показує серійні номери, інтерфейс шини, стиль розділів і розширені показники S.M.A.R.T.">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Експертний режим"
                             FontSize="11.5"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource ArgusVioletSoftBrush}"
                             VerticalAlignment="Center" />
                  <ToggleSwitch IsChecked="{Binding IsExpertMode}"
                                OnContent=""
                                OffContent=""
                                VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button Classes="argus-secondary"
                      Padding="12,7"
                      FontSize="12"
                      IsEnabled="{Binding !IsBusy}"
                      Content="Оновити диски"
                      Command="{Binding RefreshDisksCommand}"
                      VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- 0..100% Defragmentation / TRIM / Scan Progress Bar -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         FontSize="11.5"
                         Foreground="{StaticResource ArgusTextSecondaryBrush}"
                         Text="{Binding OperationStageText}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Classes="metric-mono"
                         FontSize="11.5"
                         Foreground="{StaticResource ArgusCyanBrush}"
                         Text="{Binding OperationProgressText}" />
            </Grid>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding OperationProgressPercent}"
                         Height="6"
                         CornerRadius="3"
                         Background="#161E42"
                         Foreground="{StaticResource ArgusCyanBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Physical Disks & S.M.A.R.T. Cards -->
      <Border Classes="panel" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Classes="section-heading" Text="Фізичні накопичувачі та діагностика" />

          <ItemsControl ItemsSource="{Binding Disks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhysicalDiskCardItem">
                <Border Classes="tile" Margin="0,0,0,5" Padding="11,7">
                  <Grid ColumnDefinitions="*,Auto,Auto">

                    <!-- Left: Model, Bus, Capacity, S/N & S.M.A.R.T. Summary -->
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="pill"
                                Classes.pill-ready="{Binding IsSsdOrNvme}"
                                Padding="7,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding MediaBadge}"
                                     FontSize="10.5"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource ArgusTextPrimaryBrush}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Classes="metric-mono"
                                 FontSize="11.5"
                                 Text="{Binding BasicCapacityText}"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- Expert-only Hardware Metadata & Detailed S.M.A.R.T. Strip -->
                      <Border Background="#0E142D"
                              BorderBrush="{StaticResource ArgusBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="9,5"
                              Margin="0,4,0,0"
                              IsVisible="{Binding $parent[UserControl].((vm:DisksViewModel)DataContext).IsExpertMode}">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="metric-mono"
                                     FontSize="11"
                                     Text="{Binding BusAndCapacityText}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="metric-mono"
                                     FontSize="10.5"
                                     Foreground="{StaticResource ArgusTextMutedBrush}"
                                     Text="{Binding SerialText}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="11"
                                     Foreground="{StaticResource ArgusEmeraldBrush}"
                                     Text="{Binding SmartDetailsText}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Middle: S.M.A.R.T. Health & Temp Badges -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                      <Border Classes="pill"
                              Classes.pill-ready="{Binding IsHealthy}"
                              Classes.pill-warn="{Binding IsCaution}"
                              Classes.pill-danger="{Binding IsCritical}"
                              Padding="9,3">
                        <TextBlock Text="{Binding HealthLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ArgusTextPrimaryBrush}" />
                      </Border>

                      <Border Classes="pill" Padding="9,3" IsVisible="{Binding HasTemperature}">
                        <TextBlock Classes="metric-mono"
                                   FontSize="11"
                                   Text="{Binding TemperatureText}" />
                      </Border>
                    </StackPanel>

                    <!-- Right: Action Button -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="argus-primary"
                              Padding="13,6"
                              FontSize="11.5"
                              IsVisible="{Binding HasDriveLetter}"
                              Content="{Binding OptimizeButtonLabel}"
                              ToolTip.Tip="{Binding OptimizeTooltip}"
                              Command="{Binding OptimizeCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Visual Large-Folder Space Map & Interactive Drill-Down -->
      <Border Classes="panel-hero" Padding="14,11">
        <Border.Styles>
          <Style Selector="Button.folder-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{StaticResource ArgusTextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
          <Style Selector="Button.folder-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource ArgusCyanBrush}" />
          </Style>
          <Style Selector="Button.folder-link:disabled">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Cursor" Value="Arrow" />
          </Style>
          <Style Selector="Button.argus-danger">
            <Setter Property="Background" Value="#361420" />
            <Setter Property="Foreground" Value="#FFE6EA" />
            <Setter Property="BorderBrush" Value="{StaticResource ArgusCoralBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
          <Style Selector="Button.argus-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#521B2E" />
            <Setter Property="BorderBrush" Value="#FF8591" />
            <Setter Property="Foreground" Value="#FFFFFF" />
          </Style>
          <Style Selector="Button.argus-danger:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
          </Style>
        </Border.Styles>

        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="section-heading" Text="Карта найбільших тек на томі" />
              <TextBlock Classes="metric-mono"
                         FontSize="11.5"
                         Text="{Binding SelectedVolumeSummaryText}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding VolumeTabs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VolumeTabItem">
                  <Button Classes="argus-secondary"
                          Classes.selected="{Binding IsSelected}"
                          Padding="12,5"
                          FontSize="12"
                          Content="{Binding Label}"
                          Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Drill-Down Breadcrumb Navigation & Selection Action Toolbar -->
          <Border Background="#0E142D"
                  BorderBrush="{StaticResource ArgusBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10,7">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="pill" Padding="8,3" VerticalAlignment="Center">
                  <TextBlock Classes="metric-mono"
                             FontSize="11.5"
                             Foreground="{StaticResource ArgusCyanBrush}"
                             Text="{Binding CurrentBrowsePath}"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Classes="argus-secondary"
                        Padding="10,4"
                        FontSize="11.5"
                        IsVisible="{Binding IsInsideSubfolder}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="← На рівень вище"
                        Command="{Binding NavigateUpCommand}"
                        VerticalAlignment="Center" />
                <Button Classes="argus-secondary"
                        Padding="10,4"
                        FontSize="11.5"
                        IsVisible="{Binding IsInsideSubfolder}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="До кореня тому"
                        Command="{Binding NavigateRootCommand}"
                        VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="pill"
                        Padding="8,3"
                        IsVisible="{Binding HasSelectedEntries}"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource ArgusTextSecondaryBrush}"
                               Text="Вибрано:" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11"
                               Foreground="{StaticResource ArgusTextPrimaryBrush}"
                               Text="{Binding SelectedEntriesCount}" />
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource ArgusTextMutedBrush}"
                               Text="·" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11"
                               Foreground="{StaticResource ArgusAmberBrush}"
                               Text="{Binding SelectedEntriesSizeText}" />
                  </StackPanel>
                </Border>
                <Button Classes="argus-danger"
                        Padding="11,5"
                        FontSize="11.5"
                        IsEnabled="{Binding HasSelectedEntries}"
                        Content="Видалити у Кошик"
                        Command="{Binding RequestDeleteSelectedCommand}"
                        VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Inline Safe Recycle Bin Deletion Confirmation Banner -->
          <Border Background="#2A121C"
                  BorderBrush="{StaticResource ArgusCoralBrush}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="12,9"
                  IsVisible="{Binding IsDeleteConfirmationOpen}">
            <Grid ColumnDefinitions="*,12,Auto">
              <TextBlock Grid.Column="0"
                         FontSize="12"
                         Foreground="{StaticResource ArgusTextPrimaryBrush}"
                         Text="{Binding DeleteConfirmationText}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="argus-danger"
                        Padding="12,6"
                        FontSize="11.5"
                        IsEnabled="{Binding !IsBusy}"
                        Content="Так, перемістити у Кошик"
                        Command="{Binding ConfirmDeleteSelectedCommand}" />
                <Button Classes="argus-secondary"
                        Padding="11,6"
                        FontSize="11.5"
                        Content="Скасувати"
                        Command="{Binding CancelDeleteSelectedCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Empty Folder Hint -->
          <TextBlock FontSize="12"
                     Foreground="{StaticResource ArgusTextMutedBrush}"
                     Text="У цій теці немає доступних підтек або файлів."
                     IsVisible="{Binding IsFolderEmpty}"
                     Margin="2,4" />

          <!-- Subfolders & Files Space Grid -->
          <ItemsControl ItemsSource="{Binding LargestFolders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderSpaceRowItem">
                <Border Classes="tile" Margin="0,0,8,6" Padding="11,7" ToolTip.Tip="{Binding FullPath}">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding CanSelect}"
                                ToolTip.Tip="{Binding SelectionTooltip}"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0" />

                      <!-- Clickable folder name for drill-down -->
                      <Button Grid.Column="1"
                              Classes="folder-link"
                              IsVisible="{Binding IsDirectory}"
                              IsEnabled="{Binding CanOpen}"
                              Command="{Binding OpenCommand}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <TextBlock FontSize="12.5"
                                     FontWeight="SemiBold"
                                     Text="{Binding Name}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="12.5"
                                     Foreground="{StaticResource ArgusCyanBrush}"
                                     Text="›"
                                     IsVisible="{Binding CanOpen}" />
                        </StackPanel>
                      </Button>

                      <!-- Non-clickable file name -->
                      <TextBlock Grid.Column="1"
                                 IsVisible="{Binding IsFile}"
                                 FontSize="12.5"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource ArgusTextPrimaryBrush}"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />

                      <!-- Type & Protection Badges -->
                      <StackPanel Grid.Column="2"
                                  Orientation="Horizontal"
                                  Spacing="4"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0">
                        <Border Classes="pill" Padding="6,1" VerticalAlignment="Center">
                          <TextBlock FontSize="10"
                                     Foreground="{StaticResource ArgusTextSecondaryBrush}"
                                     Text="{Binding TypeBadge}" />
                        </Border>
                        <Border Classes="pill"
                                Classes.pill-warn="{Binding IsProtectedPath}"
                                Classes.pill-danger="{Binding IsReparsePoint}"
                                Padding="6,1"
                                IsVisible="{Binding IsBlocked}"
                                ToolTip.Tip="{Binding SelectionTooltip}"
                                VerticalAlignment="Center">
                          <TextBlock FontSize="10"
                                     Foreground="{StaticResource ArgusAmberBrush}"
                                     Text="{Binding ProtectionBadgeText}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Grid.Column="3"
                                 Classes="metric-mono"
                                 FontSize="12"
                                 Text="{Binding SizeText}"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BarPercent}"
                                 Height="6"
                                 CornerRadius="3"
                                 Background="#1A2248"
                                 Foreground="{StaticResource ArgusCyanBrush}" />
                    <TextBlock FontSize="11"
                               Foreground="{StaticResource ArgusTextMutedBrush}"
                               Text="{Binding DetailText}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
