<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.DisksView"
             x:DataType="vm:DisksViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="12" Margin="0,0,4,12">

      <!-- Top Safe Policy, Status & 0..100% Optimization Progress Header -->
      <Border Classes="panel-hero" Padding="14,10">
        <StackPanel Spacing="8">
          <!-- Contextual UAC Callout for Disk TRIM / Defragmentation -->
          <Border Classes="uac-callout" IsVisible="{Binding NeedsElevation}">
            <Grid ColumnDefinitions="Auto,10,*,12,Auto">
              <Path Grid.Column="0"
                    Width="16"
                    Height="16"
                    Stretch="Uniform"
                    Data="{StaticResource IconShield}"
                    Stroke="{DynamicResource ArgusAmberBrush}"
                    StrokeThickness="1.6"
                    VerticalAlignment="Center" />
              <TextBlock Grid.Column="2"
                         FontSize="12"
                         Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                         Text="Діагностика S.M.A.R.T. і карта місця працюють без прав адміністратора. Для запуску оптимізації SSD (TRIM) або дефрагментації HDD потрібне підвищення прав (UAC)."
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <Button Grid.Column="4"
                      Classes="privilege-pill"
                      Content="Підвищити права (UAC)"
                      Command="{Binding RequestElevationCommand}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0" VerticalAlignment="Center">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Classes="section-heading" Text="Політика безпеки та S.M.A.R.T." VerticalAlignment="Center" Margin="0,0,8,4" />
                <Border Classes="pill pill-ready" Padding="7,2" Margin="0,0,6,4">
                  <TextBlock Text="SSD / NVMe: безпечна оптимізація" FontSize="10.5" Foreground="{DynamicResource ArgusEmeraldBrush}" />
                </Border>
                <Border Classes="pill" Padding="7,2" Margin="0,0,6,4">
                  <TextBlock Text="HDD: дефрагментація" FontSize="10.5" Foreground="{DynamicResource ArgusCyanBrush}" />
                </Border>
                <Border Classes="pill" Padding="7,2" Margin="0,0,6,4">
                  <TextBlock Text="{Binding FleetSummaryText}" FontSize="10.5" Foreground="{DynamicResource ArgusVioletSoftBrush}" />
                </Border>
              </WrapPanel>

              <TextBlock FontSize="12"
                         Classes.warn-text="{Binding !StatusIsSuccess}"
                         Text="{Binding StatusBannerText}"
                         TextWrapping="Wrap">
                <TextBlock.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource ArgusEmeraldBrush}" />
                  </Style>
                  <Style Selector="TextBlock.warn-text">
                    <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
                  </Style>
                </TextBlock.Styles>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border Classes="expert-toggle-bar"
                      ToolTip.Tip="Показує серійні номери, інтерфейс шини, стиль розділів і розширені показники S.M.A.R.T.">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Експертний режим"
                             FontSize="11.5"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource ArgusVioletSoftBrush}"
                             VerticalAlignment="Center" />
                  <ToggleSwitch IsChecked="{Binding IsExpertMode}"
                                OnContent=""
                                OffContent=""
                                VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button Classes="argus-secondary"
                      Padding="12,7"
                      FontSize="12"
                      IsEnabled="{Binding !IsBusy}"
                      Content="Оновити диски"
                      Command="{Binding RefreshDisksCommand}"
                      VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- 0..100% Defragmentation / TRIM / Scan Progress Bar -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         FontSize="11.5"
                         Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                         Text="{Binding OperationStageText}"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1"
                         Classes="metric-mono"
                         FontSize="11.5"
                         Foreground="{DynamicResource ArgusCyanBrush}"
                         Text="{Binding OperationProgressText}" />
            </Grid>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding OperationProgressPercent}"
                         Height="6"
                         CornerRadius="3"
                         Background="{DynamicResource ArgusBorderBrush}"
                         Foreground="{DynamicResource ArgusCyanBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Physical Disks & S.M.A.R.T. Cards -->
      <Border Classes="panel" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Classes="section-heading" Text="Фізичні накопичувачі та діагностика" />

          <ItemsControl ItemsSource="{Binding Disks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PhysicalDiskCardItem">
                <Border Classes="tile" Margin="0,0,0,5" Padding="11,7">
                  <Grid ColumnDefinitions="*,Auto,Auto">

                    <!-- Left: Model, Bus, Capacity, S/N & S.M.A.R.T. Summary -->
                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,12,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Classes="pill"
                                Classes.pill-ready="{Binding IsSsdOrNvme}"
                                Padding="7,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding MediaBadge}"
                                     FontSize="10.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                        </Border>
                      </StackPanel>

                      <TextBlock Classes="metric-mono"
                                 FontSize="11.5"
                                 Text="{Binding BasicCapacityText}"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- Expert-only Hardware Metadata & Detailed S.M.A.R.T. Strip -->
                      <Border Background="{DynamicResource ArgusBgInputBrush}"
                              BorderBrush="{DynamicResource ArgusBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="9,5"
                              Margin="0,4,0,0"
                              IsVisible="{Binding $parent[UserControl].((vm:DisksViewModel)DataContext).IsExpertMode}">
                        <StackPanel Spacing="2">
                          <TextBlock Classes="metric-mono"
                                     FontSize="11"
                                     Text="{Binding BusAndCapacityText}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="metric-mono"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusTextMutedBrush}"
                                     Text="{Binding SerialText}"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="11"
                                     Foreground="{DynamicResource ArgusEmeraldBrush}"
                                     Text="{Binding SmartDetailsText}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Middle: S.M.A.R.T. Health & Temp Badges -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                      <Border Classes="pill"
                              Classes.pill-ready="{Binding IsHealthy}"
                              Classes.pill-warn="{Binding IsCaution}"
                              Classes.pill-danger="{Binding IsCritical}"
                              Padding="9,3">
                        <TextBlock Text="{Binding HealthLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ArgusTextPrimaryBrush}" />
                      </Border>

                      <Border Classes="pill" Padding="9,3" IsVisible="{Binding HasTemperature}">
                        <TextBlock Classes="metric-mono"
                                   FontSize="11"
                                   Text="{Binding TemperatureText}" />
                      </Border>
                    </StackPanel>

                    <!-- Right: Action Button -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <Button Classes="argus-primary"
                              Padding="13,6"
                              FontSize="11.5"
                              IsVisible="{Binding HasDriveLetter}"
                              Content="{Binding OptimizeButtonLabel}"
                              ToolTip.Tip="{Binding OptimizeTooltip}"
                              Command="{Binding OptimizeCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Visual Large-Folder Space Map & Interactive Drill-Down -->
      <Border Classes="panel-hero" Padding="14,11">
        <Border.Styles>
          <Style Selector="Button.folder-row-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
          <Style Selector="Button.folder-row-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
          </Style>
          <Style Selector="Button.folder-row-button:pointerover TextBlock.folder-row-title">
            <Setter Property="Foreground" Value="{DynamicResource ArgusCyanBrush}" />
          </Style>
          <Style Selector="Button.folder-row-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArgusBgSelectedBrush}" />
          </Style>
          <Style Selector="Button.folder-row-button:disabled">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Cursor" Value="Arrow" />
          </Style>
          <Style Selector="Button.folder-row-button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
          </Style>
          <Style Selector="Button.row-trash">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
          <Style Selector="Button.row-trash Path">
            <Setter Property="Stroke" Value="{DynamicResource ArgusTextSecondaryBrush}" />
          </Style>
          <Style Selector="Button.row-trash:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArgusBgPillDangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArgusCoralBrush}" />
          </Style>
          <Style Selector="Button.row-trash:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource ArgusCoralBrush}" />
          </Style>
          <Style Selector="Button.row-trash:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArgusCoralBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArgusCoralBrush}" />
          </Style>
          <Style Selector="Button.row-trash:disabled">
            <Setter Property="Opacity" Value="0.32" />
            <Setter Property="Cursor" Value="Arrow" />
          </Style>
          <Style Selector="Button.row-trash:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
          </Style>
          <Style Selector="Button.row-trash:disabled Path">
            <Setter Property="Stroke" Value="{DynamicResource ArgusTextMutedBrush}" />
          </Style>
          <Style Selector="Button.argus-danger">
            <Setter Property="Background" Value="{DynamicResource ArgusBgPillDangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ArgusCoralBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArgusCoralBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
          </Style>
          <Style Selector="Button.argus-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ArgusCoralBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ArgusCoralBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
          </Style>
          <Style Selector="Button.argus-danger:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
          </Style>
        </Border.Styles>

        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="section-heading" Text="Карта найбільших тек на томі" />
              <TextBlock Classes="metric-mono"
                         FontSize="11.5"
                         Text="{Binding SelectedVolumeSummaryText}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding VolumeTabs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VolumeTabItem">
                  <Button Classes="argus-secondary"
                          Classes.selected="{Binding IsSelected}"
                          Padding="12,5"
                          FontSize="12"
                          Content="{Binding Label}"
                          Command="{Binding SelectCommand}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Drill-Down Breadcrumb Navigation & Selection Action Toolbar -->
          <Border Background="{DynamicResource ArgusBgInputBrush}"
                  BorderBrush="{DynamicResource ArgusBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10,7">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="pill" Padding="8,3" VerticalAlignment="Center">
                  <TextBlock Classes="metric-mono"
                             FontSize="11.5"
                             Foreground="{DynamicResource ArgusCyanBrush}"
                             Text="{Binding CurrentBrowsePath}"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Classes="argus-secondary"
                        Padding="10,4"
                        FontSize="11.5"
                        IsVisible="{Binding IsInsideSubfolder}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="← На рівень вище"
                        Command="{Binding NavigateUpCommand}"
                        VerticalAlignment="Center" />
                <Button Classes="argus-secondary"
                        Padding="10,4"
                        FontSize="11.5"
                        IsVisible="{Binding IsInsideSubfolder}"
                        IsEnabled="{Binding !IsBusy}"
                        Content="До кореня тому"
                        Command="{Binding NavigateRootCommand}"
                        VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Classes="pill"
                        Padding="8,3"
                        IsVisible="{Binding HasSelectedEntries}"
                        VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                               Text="Вибрано:" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11"
                               Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                               Text="{Binding SelectedEntriesCount}" />
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource ArgusTextMutedBrush}"
                               Text="·" />
                    <TextBlock Classes="metric-mono"
                               FontSize="11"
                               Foreground="{DynamicResource ArgusAmberBrush}"
                               Text="{Binding SelectedEntriesSizeText}" />
                  </StackPanel>
                </Border>
                <Button Classes="argus-danger"
                        Padding="11,5"
                        FontSize="11.5"
                        IsEnabled="{Binding HasSelectedEntries}"
                        Content="Видалити у Кошик"
                        Command="{Binding RequestDeleteSelectedCommand}"
                        VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Inline Safe Recycle Bin Deletion Confirmation Banner -->
          <Border Background="{DynamicResource ArgusBgPillDangerBrush}"
                  BorderBrush="{DynamicResource ArgusCoralBrush}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="12,9"
                  IsVisible="{Binding IsDeleteConfirmationOpen}">
            <Grid ColumnDefinitions="*,12,Auto">
              <TextBlock Grid.Column="0"
                         FontSize="12"
                         Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                         Text="{Binding DeleteConfirmationText}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="argus-danger"
                        Padding="12,6"
                        FontSize="11.5"
                        IsEnabled="{Binding !IsBusy}"
                        Content="Так, перемістити у Кошик"
                        Command="{Binding ConfirmDeleteSelectedCommand}" />
                <Button Classes="argus-secondary"
                        Padding="11,6"
                        FontSize="11.5"
                        Content="Скасувати"
                        Command="{Binding CancelDeleteSelectedCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Empty Folder Hint -->
          <TextBlock FontSize="12"
                     Foreground="{DynamicResource ArgusTextMutedBrush}"
                     Text="У цій теці немає доступних підтек або файлів."
                     IsVisible="{Binding IsFolderEmpty}"
                     Margin="2,4" />

          <!-- Subfolders & Files Space List (single-column, narrower for scannability) -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="820" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0"
                          ItemsSource="{Binding LargestFolders}"
                          HorizontalAlignment="Stretch">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderSpaceRowItem">
                  <Border Classes="tile" Padding="8,6" ToolTip.Tip="{Binding FullPath}">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <!-- Bulk-selection CheckBox (independent of row drill-down) -->
                      <CheckBox Grid.Column="0"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding CanSelect}"
                                ToolTip.Tip="{Binding SelectionTooltip}"
                                ToolTip.ShowOnDisabled="True"
                                VerticalAlignment="Center"
                                Margin="2,0,4,0" />

                      <!-- Quick single-item Recycle Bin delete icon button -->
                      <Button Grid.Column="1"
                              Classes="row-trash"
                              IsEnabled="{Binding CanSelect}"
                              Command="{Binding QuickDeleteCommand}"
                              ToolTip.Tip="{Binding QuickDeleteTooltip}"
                              ToolTip.ShowOnDisabled="True"
                              VerticalAlignment="Center"
                              Margin="0,0,6,0">
                        <Path Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Data="{StaticResource IconCleanup}"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              StrokeJoin="Round" />
                      </Button>

                      <!-- Full-row clickable drill-down surface (disabled with Arrow cursor for files & reparse points) -->
                      <Button Grid.Column="2"
                              Classes="folder-row-button"
                              IsEnabled="{Binding CanOpen}"
                              Command="{Binding OpenCommand}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Center">
                        <StackPanel Spacing="4">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <Grid Grid.Column="0"
                                  ColumnDefinitions="*,Auto"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0">
                              <TextBlock Grid.Column="0"
                                         Classes="folder-row-title"
                                         FontSize="12.5"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                         Text="{Binding Name}"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1"
                                         FontSize="12.5"
                                         Foreground="{DynamicResource ArgusCyanBrush}"
                                         Text="›"
                                         Margin="5,0,0,0"
                                         IsVisible="{Binding CanOpen}" />
                            </Grid>

                            <!-- Type & Protection Badges -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0">
                              <Border Classes="pill" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                           Text="{Binding TypeBadge}" />
                              </Border>
                              <Border Classes="pill"
                                      Classes.pill-warn="{Binding IsProtectedPath}"
                                      Classes.pill-danger="{Binding IsReparsePoint}"
                                      Padding="6,1"
                                      IsVisible="{Binding IsBlocked}"
                                      ToolTip.Tip="{Binding SelectionTooltip}"
                                      VerticalAlignment="Center">
                                <TextBlock FontSize="10"
                                           Foreground="{DynamicResource ArgusAmberBrush}"
                                           Text="{Binding ProtectionBadgeText}" />
                              </Border>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Classes="metric-mono"
                                       FontSize="12"
                                       Text="{Binding SizeText}"
                                       VerticalAlignment="Center" />
                          </Grid>

                          <ProgressBar Minimum="0"
                                       Maximum="100"
                                       Value="{Binding BarPercent}"
                                       Height="6"
                                       CornerRadius="3"
                                       Background="{DynamicResource ArgusBorderBrush}"
                                       Foreground="{DynamicResource ArgusCyanBrush}" />

                          <TextBlock FontSize="11"
                                     Foreground="{DynamicResource ArgusTextMutedBrush}"
                                     Text="{Binding DetailText}"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
