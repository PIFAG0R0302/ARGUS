<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Argus.App.ViewModels"
             x:Class="Argus.App.Views.StartupAndServicesView"
             x:DataType="vm:StartupAndServicesViewModel">

  <Grid RowDefinitions="Auto,12,*">

    <!-- Top Control Panel: Contextual UAC + Sub-Tabs + Expert Toggle + Search -->
    <Border Grid.Row="0" Classes="panel-hero">
      <StackPanel Spacing="10">

        <!-- Contextual On-Demand UAC Banner -->
        <Border Classes="uac-callout" IsVisible="{Binding NeedsElevation}">
          <Grid ColumnDefinitions="Auto,10,*,Auto">
            <Path Grid.Column="0"
                  Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Data="{StaticResource IconShield}"
                  Stroke="{DynamicResource ArgusAmberBrush}"
                  StrokeThickness="1.5"
                  VerticalAlignment="Center" />
            <TextBlock Grid.Column="2"
                       FontSize="12"
                       Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Text="Перегляд автозапуску й служб та перемикання елементів поточного користувача працюють без адміна. Для HKLM, Task Scheduler і керування службами потрібні права адміністратора (UAC)." />
            <Button Grid.Column="3"
                    Margin="12,0,0,0"
                    Classes="privilege-pill"
                    Content="Підвищити права (UAC)"
                    Command="{Binding RequestElevationCommand}"
                    VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Row 1: Sub-tabs + Refresh + Inline Expert Mode Toggle -->
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsStartupTab}"
                    Content="{Binding StartupTabLabel}"
                    Command="{Binding SelectSubTabCommand}"
                    CommandParameter="0" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServicesTab}"
                    Content="{Binding ServicesTabLabel}"
                    Command="{Binding SelectSubTabCommand}"
                    CommandParameter="1" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="argus-secondary"
                    Padding="12,6"
                    FontSize="12"
                    Content="Оновити"
                    IsEnabled="{Binding !IsLoading}"
                    Command="{Binding RefreshCommand}" />
            <Border Classes="expert-toggle-bar"
                    ToolTip.Tip="В експертному режимі відображаються системні завдання Microsoft у планувальнику, повні шляхи команд, імена служб і шляхи виконуваних файлів.">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Експертний режим"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ArgusVioletSoftBrush}"
                           VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding IsExpertMode}"
                              OnContent=""
                              OffContent=""
                              MinWidth="0"
                              Padding="0"
                              VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Row 2: Quick Filter Pills (no search bar) -->
        <Grid>
          <!-- Startup State Filter Pills -->
          <WrapPanel Orientation="Horizontal"
                     IsVisible="{Binding IsStartupTab}"
                     VerticalAlignment="Center">
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsStartupStateAll}"
                    Margin="0,0,6,4"
                    Content="Усі стани"
                    Command="{Binding SetStartupStateFilterCommand}"
                    CommandParameter="Усі стани" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsStartupStateEnabled}"
                    Margin="0,0,6,4"
                    Content="Увімкнено"
                    Command="{Binding SetStartupStateFilterCommand}"
                    CommandParameter="Увімкнено" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsStartupStateDisabled}"
                    Margin="0,0,0,4"
                    Content="Вимкнено"
                    Command="{Binding SetStartupStateFilterCommand}"
                    CommandParameter="Вимкнено" />
          </WrapPanel>

          <!-- Services State + Startup Type Filter Pills -->
          <WrapPanel Orientation="Horizontal"
                     IsVisible="{Binding IsServicesTab}"
                     VerticalAlignment="Center">
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStateAll}"
                    Margin="0,0,6,4"
                    Content="Усі"
                    Command="{Binding SetServiceFilterCommand}"
                    CommandParameter="Усі" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStateRunning}"
                    Margin="0,0,6,4"
                    Content="Працює"
                    Command="{Binding SetServiceFilterCommand}"
                    CommandParameter="Працює" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStateStopped}"
                    Margin="0,0,6,4"
                    Content="Зупинено"
                    Command="{Binding SetServiceFilterCommand}"
                    CommandParameter="Зупинено" />

            <Border Width="1"
                    Height="18"
                    Background="{DynamicResource ArgusBorderBrush}"
                    Margin="4,0,10,4"
                    VerticalAlignment="Center" />

            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStartModeAll}"
                    Margin="0,0,6,4"
                    Content="Усі типи"
                    Command="{Binding SetServiceStartModeFilterCommand}"
                    CommandParameter="Усі типи" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStartModeAutomatic}"
                    Margin="0,0,6,4"
                    Content="Автоматично"
                    Command="{Binding SetServiceStartModeFilterCommand}"
                    CommandParameter="Автоматично" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStartModeManual}"
                    Margin="0,0,6,4"
                    Content="Вручну"
                    Command="{Binding SetServiceStartModeFilterCommand}"
                    CommandParameter="Вручну" />
            <Button Classes="filter-pill"
                    Classes.selected="{Binding IsServiceStartModeDisabled}"
                    Margin="0,0,0,4"
                    Content="Вимкнено"
                    Command="{Binding SetServiceStartModeFilterCommand}"
                    CommandParameter="Вимкнено" />
          </WrapPanel>
        </Grid>

        <!-- Summary & Action Feedback -->
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     FontSize="12"
                     Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                     Text="{Binding SummaryText}"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     FontSize="12"
                     Foreground="{DynamicResource ArgusCyanBrush}"
                     IsVisible="{Binding HasActionFeedback}"
                     Text="{Binding ActionFeedback}"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="520"
                     VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- MBin Content List -->
    <Border Grid.Row="2" Classes="panel" Padding="14">
      <Grid>

        <!-- Sub-Tab 0: Startup Entries -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsStartupTab}">
          <!-- Clickable Sort Header Strip -->
          <Grid Grid.Row="0" ColumnDefinitions="*,12,150,12,110,12,102" Margin="12,0,18,8">
            <Button Grid.Column="0"
                    Classes="column-sort-header"
                    Classes.active="{Binding IsStartupSortByName}"
                    HorizontalAlignment="Left"
                    Content="{Binding StartupSortNameHeader}"
                    Command="{Binding SetStartupSortCommand}"
                    CommandParameter="NAME" />
            <Button Grid.Column="2"
                    Classes="column-sort-header"
                    Classes.active="{Binding IsStartupSortBySource}"
                    HorizontalAlignment="Left"
                    Content="{Binding StartupSortSourceHeader}"
                    Command="{Binding SetStartupSortCommand}"
                    CommandParameter="SOURCE" />
            <Button Grid.Column="4"
                    Classes="column-sort-header"
                    Classes.active="{Binding IsStartupSortByState}"
                    HorizontalAlignment="Left"
                    Content="{Binding StartupSortStateHeader}"
                    Command="{Binding SetStartupSortCommand}"
                    CommandParameter="STATE" />
            <TextBlock Grid.Column="6"
                       Text="ДІЯ"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ArgusTextMutedBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding StartupEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StartupEntryRowViewModel">
                <Border Classes="tile" Padding="12,10" Margin="0,0,4,8">
                  <Grid ColumnDefinitions="*,14,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <Border Classes="pill" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SourceBadge}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusCyanBrush}" />
                        </Border>
                        <Border Classes="pill pill-ready"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                IsVisible="{Binding IsEnabled}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding StateText}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusEmeraldBrush}" />
                        </Border>
                        <Border Classes="pill"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                IsVisible="{Binding !IsEnabled}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding StateText}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusTextMutedBrush}" />
                        </Border>
                        <Border Classes="pill"
                                Padding="6,1"
                                IsVisible="{Binding RequiresElevation}"
                                VerticalAlignment="Center">
                          <TextBlock Text="UAC"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusAmberBrush}" />
                        </Border>
                      </WrapPanel>

                      <TextBlock FontSize="11.5"
                                 Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                 Text="{Binding PublisherOrAuthor}" />

                      <!-- Expert Mode Technical Metadata -->
                      <StackPanel Spacing="2"
                                  IsVisible="{Binding $parent[UserControl].((vm:StartupAndServicesViewModel)DataContext).IsExpertMode}">
                        <TextBlock Classes="metric-mono"
                                   FontSize="11"
                                   Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                   Text="{Binding CommandText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding CommandText}" />
                        <TextBlock Classes="metric-mono"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ArgusTextMutedBrush}"
                                   Text="{Binding LocationPath}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Classes="argus-secondary"
                            Padding="12,6"
                            FontSize="12"
                            MinWidth="102"
                            Content="{Binding ToggleButtonLabel}"
                            Command="{Binding ToggleCommand}"
                            VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Sub-Tab 1: Windows Services -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsServicesTab}">
          <!-- Clickable Sort Header Strip -->
          <Grid Grid.Row="0" ColumnDefinitions="*,12,110,12,130,12,220" Margin="12,0,18,8">
            <Button Grid.Column="0"
                    Classes="column-sort-header"
                    Classes.active="{Binding IsServiceSortByName}"
                    HorizontalAlignment="Left"
                    Content="{Binding ServiceSortNameHeader}"
                    Command="{Binding SetServiceSortCommand}"
                    CommandParameter="NAME" />
            <Button Grid.Column="2"
                    Classes="column-sort-header"
                    Classes.active="{Binding IsServiceSortByState}"
                    HorizontalAlignment="Left"
                    Content="{Binding ServiceSortStateHeader}"
                    Command="{Binding SetServiceSortCommand}"
                    CommandParameter="STATE" />
            <Button Grid.Column="4"
                    Classes="column-sort-header"
                    Classes.active="{Binding IsServiceSortByStartMode}"
                    HorizontalAlignment="Left"
                    Content="{Binding ServiceSortStartModeHeader}"
                    Command="{Binding SetServiceSortCommand}"
                    CommandParameter="STARTMODE" />
            <TextBlock Grid.Column="6"
                       Text="КЕРУВАННЯ"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource ArgusTextMutedBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Services}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ManagedServiceRowViewModel">
                <Border Classes="tile" Padding="12,10" Margin="0,0,4,8">
                  <Grid ColumnDefinitions="*,14,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ArgusTextPrimaryBrush}"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                        <Border Classes="pill pill-ready"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                IsVisible="{Binding IsRunning}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusEmeraldBrush}" />
                        </Border>
                        <Border Classes="pill"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                IsVisible="{Binding !IsRunning}"
                                VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}"
                                     FontSize="10.5"
                                     Foreground="{DynamicResource ArgusTextMutedBrush}" />
                        </Border>
                        <Border Classes="pill"
                                Padding="6,1"
                                Margin="0,0,6,0"
                                IsVisible="{Binding IsCriticalProtected}"
                                Background="{DynamicResource ArgusBgPillWarnBrush}"
                                BorderBrush="{DynamicResource ArgusAmberBrush}"
                                ToolTip.Tip="Критична служба Windows: зупинка, перезапуск і вимкнення заблоковані для захисту стабільності ОС."
                                VerticalAlignment="Center">
                          <TextBlock Text="Захищено ОС"
                                     FontSize="10"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource ArgusAmberBrush}" />
                        </Border>
                      </WrapPanel>

                      <TextBlock FontSize="11.5"
                                 Foreground="{DynamicResource ArgusTextSecondaryBrush}"
                                 Text="{Binding Description}"
                                 IsVisible="{Binding HasDescription}"
                                 MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />

                      <!-- Expert Mode Service Details -->
                      <StackPanel Spacing="2"
                                  IsVisible="{Binding $parent[UserControl].((vm:StartupAndServicesViewModel)DataContext).IsExpertMode}">
                        <TextBlock Classes="metric-mono"
                                   FontSize="11"
                                   Foreground="{DynamicResource ArgusCyanBrush}"
                                   Text="{Binding ServiceName, StringFormat='Служба: {0}'}" />
                        <TextBlock Classes="metric-mono"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource ArgusTextMutedBrush}"
                                   Text="{Binding BinaryPath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding BinaryPath}" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                      <ComboBox Width="122"
                                FontSize="11.5"
                                ItemsSource="{Binding StartModeOptions}"
                                SelectedIndex="{Binding SelectedStartModeIndex}"
                                IsEnabled="{Binding CanChangeStartMode}"
                                ToolTip.Tip="Тип запуску служби Windows" />
                      <Button Classes="argus-secondary"
                              Padding="9,5"
                              FontSize="11.5"
                              Content="Старт"
                              IsEnabled="{Binding CanStart}"
                              Command="{Binding StartCommand}" />
                      <Button Classes="argus-secondary"
                              Padding="9,5"
                              FontSize="11.5"
                              Content="Стоп"
                              IsEnabled="{Binding CanStop}"
                              Command="{Binding StopCommand}" />
                      <Button Classes="argus-secondary"
                              Padding="9,5"
                              FontSize="11.5"
                              Content="Перезапуск"
                              IsEnabled="{Binding CanRestart}"
                              Command="{Binding RestartCommand}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

      </Grid>
    </Border>
  </Grid>
</UserControl>
