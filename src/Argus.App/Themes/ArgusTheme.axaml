<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Core Base Palette: Deep Observatory Blue-Violet -->
    <Color x:Key="ArgusObsidianBlue">#060916</Color>
    <Color x:Key="ArgusAbyssIndigo">#0B1026</Color>
    <Color x:Key="ArgusNebulaSlate">#111735</Color>
    <Color x:Key="ArgusNebulaElevated">#171F45</Color>
    <Color x:Key="ArgusTwilightEdge">#242E63</Color>
    <Color x:Key="ArgusTwilightBright">#3A478F</Color>
    <Color x:Key="ArgusIonViolet">#7C5CFF</Color>
    <Color x:Key="ArgusIonVioletSoft">#A48BFF</Color>
    <Color x:Key="ArgusTelemetryCyan">#38D9F5</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="ArgusSignalEmerald">#2DD4A8</Color>
    <Color x:Key="ArgusSolarAmber">#F5A623</Color>
    <Color x:Key="ArgusThermalCoral">#F45B69</Color>

    <!-- Text Hierarchy -->
    <Color x:Key="ArgusStarlight">#EDF1FF</Color>
    <Color x:Key="ArgusMistBlue">#95A0CC</Color>
    <Color x:Key="ArgusDimSlate">#5E6A96</Color>

    <!-- Named Brushes -->
    <SolidColorBrush x:Key="ArgusBgCanvasBrush" Color="{StaticResource ArgusObsidianBlue}" />
    <SolidColorBrush x:Key="ArgusBgRailBrush" Color="{StaticResource ArgusAbyssIndigo}" />
    <SolidColorBrush x:Key="ArgusBgPanelBrush" Color="{StaticResource ArgusNebulaSlate}" />
    <SolidColorBrush x:Key="ArgusBgCardBrush" Color="{StaticResource ArgusNebulaElevated}" />
    <SolidColorBrush x:Key="ArgusBorderBrush" Color="{StaticResource ArgusTwilightEdge}" />
    <SolidColorBrush x:Key="ArgusBorderBrightBrush" Color="{StaticResource ArgusTwilightBright}" />
    <SolidColorBrush x:Key="ArgusVioletBrush" Color="{StaticResource ArgusIonViolet}" />
    <SolidColorBrush x:Key="ArgusVioletSoftBrush" Color="{StaticResource ArgusIonVioletSoft}" />
    <SolidColorBrush x:Key="ArgusCyanBrush" Color="{StaticResource ArgusTelemetryCyan}" />
    <SolidColorBrush x:Key="ArgusEmeraldBrush" Color="{StaticResource ArgusSignalEmerald}" />
    <SolidColorBrush x:Key="ArgusAmberBrush" Color="{StaticResource ArgusSolarAmber}" />
    <SolidColorBrush x:Key="ArgusCoralBrush" Color="{StaticResource ArgusThermalCoral}" />
    <SolidColorBrush x:Key="ArgusTextPrimaryBrush" Color="{StaticResource ArgusStarlight}" />
    <SolidColorBrush x:Key="ArgusTextSecondaryBrush" Color="{StaticResource ArgusMistBlue}" />
    <SolidColorBrush x:Key="ArgusTextMutedBrush" Color="{StaticResource ArgusDimSlate}" />

    <!-- Interactive & Semantic State Fallback Brushes -->
    <SolidColorBrush x:Key="ArgusBgInputBrush" Color="#0A0F24" />
    <SolidColorBrush x:Key="ArgusBgHoverBrush" Color="#18204A" />
    <SolidColorBrush x:Key="ArgusBgSelectedBrush" Color="#1C2152" />
    <SolidColorBrush x:Key="ArgusBgPillOkBrush" Color="#0E2E2B" />
    <SolidColorBrush x:Key="ArgusBgPillWarnBrush" Color="#2E220D" />
    <SolidColorBrush x:Key="ArgusBgPillDangerBrush" Color="#31131D" />
    <SolidColorBrush x:Key="ArgusPrimaryButtonBgBrush" Color="#5E42E8" />
    <SolidColorBrush x:Key="ArgusPrimaryButtonHoverBrush" Color="#7358FA" />
    <SolidColorBrush x:Key="ArgusSecondaryButtonBgBrush" Color="#161D42" />
    <SolidColorBrush x:Key="ArgusSecondaryButtonHoverBrush" Color="#1F2859" />

    <!-- Subtle Atmosphere & Signature Gradient Brushes -->
    <LinearGradientBrush x:Key="ArgusWorkspaceBackdrop" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#060916" Offset="0" />
      <GradientStop Color="#0B1028" Offset="0.58" />
      <GradientStop Color="#120E2E" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ArgusAccentLineBrush" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Color="#38D9F5" Offset="0" />
      <GradientStop Color="#7C5CFF" Offset="0.55" />
      <GradientStop Color="#242E63" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ArgusHeroCardBorderBrush" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Color="#5238D9F5" Offset="0" />
      <GradientStop Color="#667C5CFF" Offset="0.45" />
      <GradientStop Color="#242E63" Offset="1" />
    </LinearGradientBrush>

    <!-- Font Families -->
    <FontFamily x:Key="ArgusMonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!-- Navigation Vector Geometries (16x16 coordinate box) -->
    <StreamGeometry x:Key="IconOverview">M2,2 H7 V7 H2 Z M9,2 H14 V7 H9 Z M2,9 H7 V14 H2 Z M9,9 H14 V14 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="IconMonitoring">M1,9 H4 L6,3 L9,13 L11,7 L12.5,9 H15</StreamGeometry>
    <StreamGeometry x:Key="IconNetwork">M8,1.5 A6.5,6.5 0 1 1 7.99,1.5 Z M1.8,8 H14.2 M8,1.5 C10.4,3.8 10.4,12.2 8,14.5 M8,1.5 C5.6,3.8 5.6,12.2 8,14.5</StreamGeometry>
    <StreamGeometry x:Key="IconDevices">M4,4 H12 V12 H4 Z M6,1 V4 M10,1 V4 M6,12 V15 M10,12 V15 M1,6 H4 M1,10 H4 M12,6 H15 M12,10 H15</StreamGeometry>
    <StreamGeometry x:Key="IconCleanup">M3,4 H13 M5,4 V13 H11 V4 M6.5,2 H9.5 M7,7 V11 M9,7 V11</StreamGeometry>
    <StreamGeometry x:Key="IconDisks">M2,4 C2,2.8 4.7,2 8,2 C11.3,2 14,2.8 14,4 V12 C14,13.2 11.3,14 8,14 C4.7,14 2,13.2 2,12 Z M2,8 C2,9.2 4.7,10 8,10 C11.3,10 14,9.2 14,8</StreamGeometry>
    <StreamGeometry x:Key="IconMigration">M2,5 H11 M8,2 L11,5 L8,8 M14,11 H5 M8,8 L5,11 L8,14</StreamGeometry>
    <StreamGeometry x:Key="IconProcesses">M2,3.5 H14 M2,8 H14 M2,12.5 H10 M11.5,11 L13.5,12.5 L11.5,14</StreamGeometry>
    <StreamGeometry x:Key="IconStartupServices">M8,1.5 V8 M4.5,3.5 C2.8,4.9 2,7.1 2.4,9.4 C3,12.4 5.5,14.5 8,14.5 C10.5,14.5 13,12.4 13.6,9.4 C14,7.1 13.2,4.9 11.5,3.5</StreamGeometry>
    <StreamGeometry x:Key="IconJournal">M3,2 H13 V14 H3 Z M5.5,5.5 H10.5 M5.5,8.5 H10.5 M5.5,11.5 H8.5</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M2,4 H14 M2,8 H14 M2,12 H14 M5,2.5 V5.5 M11,6.5 V9.5 M7,10.5 V13.5</StreamGeometry>

    <!-- Window Chrome & Privilege Vector Icons -->
    <StreamGeometry x:Key="IconWinMinimize">M2,8 H14</StreamGeometry>
    <StreamGeometry x:Key="IconWinMaximize">M3,3 H13 V13 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconWinRestore">M3,5 H11 V13 H3 Z M5,5 V3 H13 V11 H11</StreamGeometry>
    <StreamGeometry x:Key="IconWinClose">M3,3 L13,13 M13,3 L3,13</StreamGeometry>
    <StreamGeometry x:Key="IconShield">M8,1.5 L13.5,3.8 V7.8 C13.5,11.2 11.1,13.6 8,14.8 C4.9,13.6 2.5,11.2 2.5,7.8 V3.8 Z</StreamGeometry>
  </Styles.Resources>

  <!-- Typography Roles -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.page-subtitle">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.section-heading">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.body-muted">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.metric-mono">
    <Setter Property="FontFamily" Value="{StaticResource ArgusMonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusCyanBrush}" />
  </Style>

  <Style Selector="TextBlock.metric-large">
    <Setter Property="FontFamily" Value="{StaticResource ArgusMonoFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <!-- Panel & Card Surfaces (Hierarchical Corner Radii: 12px Panels, 8px Inner Tiles, 6px Pills) -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.panel-hero">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusHeroCardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource ArgusBgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>

  <!-- Selectable Tile ListBox (preserves SelectedItem and scroll position during live updates) -->
  <Style Selector="ListBox.argus-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.argus-list > ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ListBox.argus-list > ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.argus-list > ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.argus-list > ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.argus-list > ListBoxItem:pointerover Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrightBrush}" />
  </Style>
  <Style Selector="ListBox.argus-list > ListBoxItem:selected Border.tile">
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusCyanBrush}" />
    <Setter Property="Background" Value="{DynamicResource ArgusSecondaryButtonBgBrush}" />
  </Style>

  <!-- Clickable Column Sort Header Button -->
  <Style Selector="Button.column-sort-header">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.column-sort-header:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.column-sort-header.active">
    <Setter Property="Foreground" Value="{DynamicResource ArgusCyanBrush}" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource ArgusBgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrightBrush}" />
  </Style>

  <Style Selector="Border.pill-ready">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPillOkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusEmeraldBrush}" />
  </Style>

  <Style Selector="Border.pill-warn">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPillWarnBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusAmberBrush}" />
  </Style>

  <Style Selector="Border.pill-danger">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPillDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusCoralBrush}" />
  </Style>

  <!-- Navigation Rail Group Header & Button -->
  <Style Selector="TextBlock.nav-group-header">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextMutedBrush}" />
    <Setter Property="Margin" Value="10,2,0,4" />
  </Style>

  <Style Selector="Button.nav-item">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="11,8" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrightBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.nav-item.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusVioletBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <!-- Primary & Secondary Action Buttons -->
  <Style Selector="Button.argus-primary">
    <Setter Property="Background" Value="{DynamicResource ArgusPrimaryButtonBgBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusVioletSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.argus-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusPrimaryButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusCyanBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.argus-secondary">
    <Setter Property="Background" Value="{DynamicResource ArgusSecondaryButtonBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.argus-secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusSecondaryButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusVioletBrush}" />
  </Style>

  <Style Selector="Button.argus-secondary.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusCyanBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <!-- Filter & Sub-Tab Pill Buttons -->
  <Style Selector="Button.filter-pill">
    <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.filter-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusSecondaryButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusVioletBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.filter-pill.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusCyanBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <!-- Profile Selector Buttons -->
  <Style Selector="Button.profile-card">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource ArgusBgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.profile-card.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusCyanBrush}" />
  </Style>

  <!-- TextBox & NumericUpDown Dark Blue-Violet Styling -->
  <Style Selector="TextBox.argus-input">
    <Setter Property="Background" Value="{DynamicResource ArgusBgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="NumericUpDown.argus-numeric">
    <Setter Property="Background" Value="{DynamicResource ArgusBgInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource ArgusMonoFont}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Custom Window Chrome Buttons -->
  <Style Selector="Button.titlebar-btn">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.titlebar-btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusTextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.titlebar-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C93346" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.privilege-pill">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPillWarnBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusAmberBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusAmberBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.privilege-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#3C2C10" />
    <Setter Property="BorderBrush" Value="#FFD076" />
  </Style>

  <Style Selector="Button.privilege-pill.elevated">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPillOkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusEmeraldBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ArgusEmeraldBrush}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Hybrid Basic / Expert Mode Inline Toggle Bar -->
  <Style Selector="Border.expert-toggle-bar">
    <Setter Property="Background" Value="{DynamicResource ArgusBgHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusBorderBrightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Contextual On-Demand UAC Elevation Banner -->
  <Style Selector="Border.uac-callout">
    <Setter Property="Background" Value="{DynamicResource ArgusBgPillWarnBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ArgusAmberBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
</Styles>
